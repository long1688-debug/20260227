{
  "watch": [
    "server/"
  ],
  "ignore": [
    "node_modules",
    "dist",
    "logs",
    "*.log",
    "tauri-app/dist",
    "tauri-app/node_modules",
    "tauri-app/src-tauri/target"
  ],
  "ext": "js,json,env",
  "delay": "1000",
  "events": {
    "restart": "echo \"🔁 服务已重启 - $(date)\"",
    "crash": "echo \"💥 服务崩溃，请检查日志\""
  },
  "verbose": true,
  "env": {
    "NODE_ENV": "development",
    "DEBUG": "*"
  }
}
