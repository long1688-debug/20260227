{
  "name": "training-teaching-system",
  "version": "2.0.0",
  "description": "实训教学实践系统 - Tauri 版",
  "author": "Training Team",
  "scripts": {
    "dev": "cd tauri-app && npm run tauri:dev",
    "build": "cd tauri-app && npm run tauri:build",
    "dev:server": "cd server && nodemon server.js",
    "dev:license": "cd server && nodemon license-final-server.js",
    "dev:backend": "concurrently -k \"npm run dev:server\" \"npm run dev:license\"",
    "server:api": "cd server && node --inspect=9229 server.js",
    "server:api:watch": "cd server && nodemon --inspect=9229 server.js",
    "server:license": "cd server && node license-final-server.js",
    "server:license:watch": "cd server && nodemon license-final-server.js",
    "dev:check": "cd tauri-app && npm run dev:check",
    "tauri:dev": "cd tauri-app && npm run tauri:dev",
    "tauri:build": "cd tauri-app && npm run tauri:build",
    "tauri:icon": "cd tauri-app && npm run tauri:icon",
    "health": "node utils/health-check.js",
    "health:watch": "nodemon --exec \"node utils/health-check.js\" --watch utils/health-check.js",
    "docker:up": "docker-compose -f docker-compose.dev.yml up -d",
    "docker:down": "docker-compose -f docker-compose.dev.yml down",
    "docker:build": "docker-compose -f docker-compose.dev.yml build",
    "docker:logs": "docker-compose -f docker-compose.dev.yml logs -f",
    "docker:dev": "docker-compose -f docker-compose.dev.yml up --build",
    "stop": "taskkill /F /IM node.exe /FI \"WINDOWTITLE eq node*\" 2>nul || echo 服务已停止",
    "dev:clean": "npm run stop && npm run dev",
    "logs": "explorer logs",
    "check:deprecated": "node utils/check-deprecated-imports.js",
    "check:migration": "node utils/comprehensive-migration-check.js",
    "predev": "npm run check:migration",
    "prebuild": "npm run check:migration"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/utilities": "^3.2.2",
    "@xenova/transformers": "^2.17.1",
    "autoprefixer": "^10.5.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "fluent-ffmpeg": "^2.1.2",
    "jquery": "^4.0.0",
    "jquery-ui": "^1.14.2",
    "jszip": "^3.10.1",
    "jszip-utils": "^0.1.0",
    "onnxruntime-web": "^1.17.3",
    "postcss": "^8.5.14",
    "pptxjs": "^0.0.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "uuid": "^14.0.0",
    "ws": "^8.19.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "nodemon": "^3.1.14"
  }
}
