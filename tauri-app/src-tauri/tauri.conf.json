{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "实训教学系统 - 教师端",
  "version": "2.0.0",
  "identifier": "com.training.teaching.teacher",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:5181",
    "beforeBuildCommand": "npm run build",
    "beforeDevCommand": "npm run dev"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "实训教学系统 - 教师端",
        "width": 1920,
        "height": 1080,
        "minWidth": 1280,
        "minHeight": 720,
        "maxWidth": 3840,
        "maxHeight": 2160,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-eval' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: asset: https://cdn.jsdelivr.net; connect-src 'self' https://huggingface.co https://hf.co blob: asset:; worker-src 'self' blob:;",
      "dangerousDisableAssetCspModification": false
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "msi",
      "nsis",
      "appimage",
      "deb",
      "rpm"
    ],
    "resources": {
      "../rtsp-proxy/*": "rtsp-proxy/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "wix": {
        "language": "zh-CN"
      },
      "nsis": {
        "displayLanguageSelector": true,
        "languages": [
          "SimpChinese",
          "English"
        ],
        "installerIcon": "icons/icon.ico"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libgtk-3-0",
          "libwebkit2gtk-4.0-37",
          "libappindicator3-1"
        ]
      },
      "rpm": {
        "depends": [
          "gtk3",
          "webkit2gtk4.0",
          "libappindicator-gtk3"
        ]
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "updater": {
      "endpoints": [],
      "pubkey": "",
      "dialog": true
    },
    "dialog": null,
    "fs": null
  }
}
