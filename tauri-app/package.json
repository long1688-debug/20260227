{
  "name": "training-teaching-system-tauri",
  "version": "2.0.0",
  "description": "实训教学实践系统 - Tauri 版",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:check": "node ./scripts/check-dev-port.js",
    "dev:react": "vite --config vite.react.config.js",
    "build": "vite build",
    "build:react": "vite build --config vite.react.config.js",
    "preview": "vite preview",
    "tauri": "tauri",
    "server:start": "cd ../server && npm run dev",
    "server:check": "curl http://localhost:3000/api/health || echo '后端服务未运行'",
    "zlmediakit:check": "curl http://127.0.0.1:801/index/api/getServerInfo || echo 'ZLMediaKit服务未运行'",
    "tauri:dev": "tauri dev",
    "tauri:dev:full": "tauri dev",
    "tauri:dev:with-server": "concurrently -n \"Server,Tauri\" -c \"yellow,green\" -k \"npm run server:start\" \"tauri dev\"",
    "tauri:build": "tauri build",
    "tauri:icon": "tauri icon",
    "tauri:build:windows": "tauri build --target x86_64-pc-windows-msvc",
    "tauri:build:windows-arm": "tauri build --target aarch64-pc-windows-msvc",
    "tauri:build:linux": "tauri build --target x86_64-unknown-linux-gnu",
    "tauri:build:linux-arm": "tauri build --target aarch64-unknown-linux-gnu",
    "tauri:build:android": "tauri build --target aarch64-linux-android",
    "tauri:build:uos": "tauri build --target x86_64-unknown-linux-gnu",
    "tauri:build:kylin": "tauri build --target x86_64-unknown-linux-gnu",
    "build:windows": "tauri build --target x86_64-pc-windows-msvc",
    "build:linux": "tauri build --target x86_64-unknown-linux-gnu",
    "build:android": "tauri build --target aarch64-linux-android"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@element-plus/icons-vue": "^2.3.1",
    "@tailwindcss/postcss": "^4.2.4",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.0",
    "@tauri-apps/plugin-fs": "^2.5.0",
    "@tauri-apps/plugin-shell": "^2.0.0",
    "@tauri-apps/plugin-updater": "^2.0.0",
    "@xenova/transformers": "^2.17.1",
    "clsx": "^2.1.0",
    "docx-preview": "^0.3.7",
    "element-plus": "^2.4.4",
    "flv.js": "^1.6.2",
    "hls.js": "^1.6.16",
    "mammoth": "^1.12.0",
    "mind-elixir": "^5.11.0",
    "onnxruntime-web": "^1.17.3",
    "pdfjs-dist": "^4.0.379",
    "pinia": "^2.1.7",
    "pptx-parser": "^1.1.7-beta.9",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^2.2.0",
    "uuid": "^14.0.0",
    "vue": "^3.3.11",
    "vue-router": "^4.2.5",
    "xlsx": "^0.18.5",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitejs/plugin-vue": "^4.5.0",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.33",
    "sass": "^1.98.0",
    "tailwindcss": "^3.4.1",
    "vite": "^5.0.8"
  }
}
