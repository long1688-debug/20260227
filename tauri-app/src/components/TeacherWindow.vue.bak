import SubtitleManagerDialog from './teacher-window/dialogs/SubtitleManagerDialog.vue'
import AddSourceDialog from './teacher-window/dialogs/AddSourceDialog.vue'
// 馃幆 棰勭暀鍔熻兘缁勪欢锛堝鏈轰綅銆乂R褰曞埗銆佽壊閿姞鍍忋€佽棰戣浆瀛楀箷锛?
