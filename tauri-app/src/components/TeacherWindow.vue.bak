// 馃幆 澶勭悊浠庨瑙堟爮鎷栨嫿鏀剧疆鍒拌棰戝尯鍩燂紙HTML5 鎷栨嫿锛?
const handleDropSourceFromPreview = (data) => {
  console.log('[TeacherWindow] 鎷栨嫿鏀剧疆:', data)

  const { source, slotIndex, position } = data

  if (!source || !slotIndex) {
    console.warn('[TeacherWindow] 鏃犳晥鐨勬嫋鎷芥暟鎹?)
    return
  }

  try {
    // 鏌ユ壘瀹屾暣鐨勪俊鍙锋簮瀵硅薄
    const fullSource = allSources.value.find(s => s.id === source.id)

    if (!fullSource) {
      console.error('[TeacherWindow] 鏈壘鍒颁俊鍙锋簮:', source.id)
      ElMessage.error('鏈壘鍒颁俊鍙锋簮')
      return
    }

    console.log(`[TeacherWindow] 鏀剧疆淇″彿婧?"${fullSource.name}" 鍒版Ы浣?${slotIndex}`)

    // 馃幆 浣跨敤 useSourceDrag 鐨?handleDropToCanvas 鏂规硶
    if (typeof handleDropToCanvas === 'function') {
      // 鍒涘缓鍏嬮殕锛堝鏋滀粠棰勮鍖哄煙鎷栨嫿锛?
      const clonedSource = cloneSourceForCanvas(fullSource, slotIndex, true)

      if (clonedSource) {
        handleDropToCanvas(clonedSource, slotIndex)
        ElMessage.success(`宸插皢 "${fullSource.name}" 娣诲姞鍒扮敾甯?${slotIndex}`)
      } else {
        ElMessage.error('鍏嬮殕淇″彿婧愬け璐?)
      }
    } else {
      console.error('[TeacherWindow] handleDropToCanvas 鏂规硶涓嶅瓨鍦?)
      ElMessage.error('鎷栨嫿鍔熻兘涓嶅彲鐢?)
    }
  } catch (error) {
    console.error('[TeacherWindow] 澶勭悊鎷栨嫿鏀剧疆澶辫触:', error)
    ElMessage.error('鎷栨嫿澶辫触: ' + error.message)
  }
}

// 馃幆 澶勭悊榧犳爣鎸変笅浜嬩欢锛堢敤浜庤嚜瀹氫箟鎷栨嫿锛?
