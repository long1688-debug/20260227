 */
const loadCaptureDevices = async () => {
  try {
    console.log('[閲囬泦璁惧] 寮€濮嬪姞杞借澶囧垪琛?..')
    const devices = await listCaptureDevices()

    // 杩囨护閲囬泦鍗″拰楂樻媿浠?
    captureDevicesList.value = filterCaptureCards(devices)
    scannerDevicesList.value = filterDocumentScanners(devices)

    console.log('[閲囬泦璁惧] 鍔犺浇瀹屾垚:', {
      total: devices.length,
      captureCards: captureDevicesList.value.length,
      scanners: scannerDevicesList.value.length
    })
  } catch (error) {
    console.error('[閲囬泦璁惧] 鍔犺浇澶辫触:', error)
    ElMessage.warning('閲囬泦璁惧鍒楄〃鍔犺浇澶辫触: ' + error.message)
  }
}

// 鍔犺浇鏈湴鎽勫儚澶磋澶?
const loadLocalCameraDevices = async () => {
  try {
    console.log('[鏈湴鎽勫儚澶碷 寮€濮嬪姞杞借澶囧垪琛?..')

    // 鍏堝皾璇曡幏鍙栬澶囧垪琛紙鍗充娇娌℃湁鏉冮檺涔熻兘鑾峰彇璁惧鏁伴噺锛屽彧鏄悕绉颁細琚殣钘忥級
    let devices
    try {
      devices = await navigator.mediaDevices.enumerateDevices()
      console.log('[鏈湴鎽勫儚澶碷 璁惧鍒楄〃鑾峰彇鎴愬姛')
    } catch (enumError) {
      console.error('[鏈湴鎽勫儚澶碷 璁惧鍒楄〃鑾峰彇澶辫触:', enumError)
      // 濡傛灉 enumerateDevices 澶辫触锛屽皾璇曞厛璇锋眰鏉冮檺
      try {
        await navigator.mediaDevices.getUserMedia({ video: true })
        console.log('[鏈湴鎽勫儚澶碷 鎽勫儚澶存潈闄愬凡鑾峰彇')
        devices = await navigator.mediaDevices.enumerateDevices()
      } catch (permError) {
        console.error('[鏈湴鎽勫儚澶碷 鏉冮檺璇锋眰涔熷け璐?', permError)
        ElMessage.warning('鏃犳硶鑾峰彇鎽勫儚澶存潈闄愶紝閮ㄥ垎鍔熻兘鍙兘鍙楅檺')
        localDevices.value = []
        return
      }
    }

    // 鑾峰彇鎵€鏈夎棰戣緭鍏ヨ澶?
    const videoDevices = devices.filter(device => device.kind === 'videoinput')

    localDevices.value = videoDevices

    console.log('[鏈湴鎽勫儚澶碷 鍔犺浇瀹屾垚:', videoDevices.length, '涓澶?)
    console.log('[鏈湴鎽勫儚澶碷 璁惧鍒楄〃:', videoDevices)

    if (videoDevices.length === 0) {
      console.warn('[鏈湴鎽勫儚澶碷 鏈娴嬪埌鎽勫儚澶磋澶?)
      // 鎻愪緵鏇磋缁嗙殑鎺掓煡寤鸿
      ElMessage.warning('鏈娴嬪埌USB鎽勫儚澶磋澶囷紝璇锋鏌ワ細\n1. 鎽勫儚澶存槸鍚︽纭繛鎺n2. 鎽勫儚澶撮┍鍔ㄦ槸鍚﹀凡瀹夎\n3. 鏄惁鏈夊叾浠栫▼搴忔鍦ㄤ娇鐢ㄦ憚鍍忓ご')
    } else {
      ElMessage.success(`鎴愬姛鍔犺浇 ${videoDevices.length} 涓憚鍍忓ご璁惧`)
    }
  } catch (error) {
    console.error('[鏈湴鎽勫儚澶碷 鍔犺浇澶辫触:', error)
    ElMessage.error('鏈湴鎽勫儚澶磋澶囧垪琛ㄥ姞杞藉け璐? ' + error.message)
  }
}

