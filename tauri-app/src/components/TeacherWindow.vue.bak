// 瀵煎叆瀛楀箷
const importSubtitles = async () => {
  try {
    showSubtitleImportDialog.value = true
  } catch (error) {
    console.error('[TeacherWindow] 瀵煎叆瀛楀箷澶辫触:', error)
    ElMessage.error('瀵煎叆瀛楀箷澶辫触')
  }
}

// 澶勭悊瀛楀箷鏂囦欢瀵煎叆
const handleSubtitleImport = (file) => {
  try {
    const reader = new FileReader()
    reader.onload = (e) => {
      try {
        const content = e.target.result
        let subtitles = []

        if (file.name.endsWith('.srt')) {
          subtitles = parseSRT(content)
        } else if (file.name.endsWith('.json')) {
          subtitles = JSON.parse(content)
        } else if (file.name.endsWith('.txt')) {
          subtitles = parseTXT(content)
        }

        importedSubtitles.value = subtitles
        ElMessage.success(`鎴愬姛瑙ｆ瀽 ${subtitles.length} 鏉″瓧骞昤)
      } catch (error) {
        console.error('[TeacherWindow] 瑙ｆ瀽瀛楀箷鏂囦欢澶辫触:', error)
        ElMessage.error('瑙ｆ瀽瀛楀箷鏂囦欢澶辫触: ' + error.message)
      }
    }
    reader.readAsText(file.raw)
  } catch (error) {
    console.error('[TeacherWindow] 瀵煎叆瀛楀箷澶辫触:', error)
    ElMessage.error('瀵煎叆瀛楀箷澶辫触')
  }
}

// 瑙ｆ瀽 SRT 鏍煎紡瀛楀箷
const parseSRT = (content) => {
  const lines = content.split('\n')
  const subtitles = []
  let currentSubtitle = null
  let lineIndex = 0

  while (lineIndex < lines.length) {
    const line = lines[lineIndex].trim()
    if (!line) {
      if (currentSubtitle && currentSubtitle.text) {
        subtitles.push(currentSubtitle)
      }
      currentSubtitle = null
      lineIndex++
      continue
    }

    if (!currentSubtitle) {
      currentSubtitle = {
        index: parseInt(line),
        startTime: '',
        endTime: '',
        text: ''
      }
      lineIndex++
      continue
    }

    if (currentSubtitle.startTime === '') {
      const timeMatch = line.match(/(\d{2}:\d{2}:\d{2},\d{3})\s*-->\s*(\d{2}:\d{2}:\d{2},\d{3})/)
      if (timeMatch) {
        currentSubtitle.startTime = timeMatch[1]
        currentSubtitle.endTime = timeMatch[2]
      }
      lineIndex++
      continue
    }

    if (currentSubtitle.text) {
      currentSubtitle.text += '\n' + line
    } else {
      currentSubtitle.text = line
    }
    lineIndex++
  }

  if (currentSubtitle && currentSubtitle.text) {
    subtitles.push(currentSubtitle)
  }

  return subtitles
}

// 瑙ｆ瀽 TXT 鏍煎紡瀛楀箷锛堢函鏂囨湰锛?
const parseTXT = (content) => {
  const lines = content.split('\n').filter(line => line.trim())
  return lines.map((line, index) => ({
    index: index + 1,
    startTime: '00:00:00,000',
    endTime: '00:00:05,000',
    text: line.trim()
  }))
}

// 纭瀵煎叆瀛楀箷
