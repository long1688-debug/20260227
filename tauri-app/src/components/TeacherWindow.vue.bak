// ============================================
// 灞忓箷鍏变韩鍔熻兘
// ============================================
const screenShareStream = ref(null)
const screenShareSourceId = ref(null)

const startScreenShare = async (type) => {
  try {
    let stream = null

    switch (type) {
      case 'screen':
        stream = await navigator.mediaDevices.getDisplayMedia({
          video: { cursor: 'always' },
          audio: true
        })
        break
      case 'window':
        stream = await navigator.mediaDevices.getDisplayMedia({
          video: { cursor: 'always' },
          audio: true
        })
        break
      case 'tab':
        stream = await navigator.mediaDevices.getDisplayMedia({
          video: { cursor: 'never' },
          audio: true
        })
        break
      default:
        throw new Error('鏈煡鐨勫睆骞曞叡浜被鍨?)
    }

    screenShareStream.value = stream

    const screenShareSource = {
      id: `screen_share_${Date.now()}`,
      name: `灞忓箷鍏变韩 - ${type === 'screen' ? '鏁翠釜灞忓箷' : type === 'window' ? '绐楀彛' : '鏍囩椤?}`,
      type: 'screen',
      stream: stream,
      status: 'online',
      audioEnabled: true,
      volume: 100
    }

    addVideoSource(screenShareSource)
    screenShareSourceId.value = screenShareSource.id

    ElMessage.success('灞忓箷鍏变韩宸插惎鍔?)
    showScreenShareDialog.value = false

    stream.getVideoTracks()[0].onended = () => {
      stopScreenShare()
    }
  } catch (error) {
    console.error('鍚姩灞忓箷鍏变韩澶辫触:', error)
    if (error.name === 'NotAllowedError') {
      ElMessage.warning('鐢ㄦ埛鎷掔粷浜嗗睆骞曞叡浜潈闄?)
    } else {
      ElMessage.error('鍚姩灞忓箷鍏变韩澶辫触: ' + error.message)
    }
  }
}

const stopScreenShare = () => {
  if (screenShareStream.value) {
    screenShareStream.value.getTracks().forEach(track => track.stop())
    screenShareStream.value = null
  }

  if (screenShareSourceId.value) {
    removeVideoSource(screenShareSourceId.value)
    screenShareSourceId.value = null
  }

  ElMessage.info('灞忓箷鍏变韩宸插仠姝?)
}

