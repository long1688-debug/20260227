// 鍙屽嚮瑙嗛鏍煎瓙 - 鍒囨崲鏈€澶у寲鏄剧ず
const handleDoubleClick = (index) => {
  console.log('[TeacherWindow] 鍙屽嚮瑙嗛鏍煎瓙:', index, '褰撳墠鏈€澶у寲鐘舵€?', isMaximized.value, maximizedIndex.value)

  // 馃幆 鍏抽敭淇锛氫粠鐢诲竷鏄犲皠涓幏鍙栦俊鍙锋簮锛岃€屼笉鏄瑙堝垪琛?
  // canvasSourceMap 浣跨敤 1-based 绱㈠紩
  const sourceId = canvasSourceMap.value[index]

  if (!sourceId) {
    console.log('[TeacherWindow] 鏍煎瓙娌℃湁瑙嗛婧愶紝涓嶅鐞嗗弻鍑?)
    ElMessage.warning('璇峰厛鎷栨嫿淇″彿婧愬埌璇ユ牸瀛?)
    return
  }

  // 馃幆 鐘舵€佹満閫昏緫锛氬垏鎹㈡渶澶у寲鐘舵€?
  // maximizedIndex === index 鏃惰繕鍘燂紙璁剧疆涓?null锛夛紝鍚﹀垯鏈€澶у寲鍒拌绱㈠紩
  if (isMaximized.value && maximizedIndex.value === index) {
    // 濡傛灉褰撳墠宸茬粡鏄渶澶у寲涓旂偣鍑荤殑鏄悓涓€涓牸瀛愶紝鍒欏彇娑堟渶澶у寲
    isMaximized.value = false
    maximizedIndex.value = null // 浣跨敤 null 淇濇寔鐘舵€佷竴鑷?
    console.log('[TeacherWindow] 鍙栨秷鏈€澶у寲')
  } else {
    // 鍚﹀垯璁剧疆涓烘渶澶у寲
    isMaximized.value = true
    maximizedIndex.value = index
    console.log('[TeacherWindow] 鏈€澶у寲鏍煎瓙:', index)
  }
}

// 褰曞埗鐘舵€佸彉鍖?
const handleRecordingChanged = (data) => {
  console.log('[TeacherWindow] 褰曞埗鐘舵€佸彉鍖?, data)

  try {
    if (data && data.index !== undefined) {
      const index = data.index
      const isRecording = data.isRecording

      if (isRecording) {
        if (currentRecordingSession.value) {
          currentRecordingSession.value.isRecording = true
          currentRecordingSession.value.startTime = currentRecordingSession.value.startTime || new Date()
        }
        console.log(`[TeacherWindow] 鏍煎瓙 ${index} 寮€濮嬪綍鍒禶)
      } else {
        const stillRecording = canvasRecordingStates.value && Object.values(canvasRecordingStates.value).some(
          state => state && state.recording
        )

        if (currentRecordingSession.value && !stillRecording) {
          currentRecordingSession.value.isRecording = false
          currentRecordingSession.value.startTime = null
        }

        console.log(`[TeacherWindow] 鏍煎瓙 ${index} 鍋滄褰曞埗`)
      }
    }
  } catch (error) {
    console.error('[TeacherWindow] 澶勭悊褰曞埗鐘舵€佸彉鍖栧け璐?, error)
  }
}

// 馃幆 澶勭悊瑙嗛鏍煎瓙鐨勬嫋鎷芥斁缃紙浠庨瑙堟爮鎷栨嫿锛?
const handleVideoDrop = (event, index) => {
  console.log('[TeacherWindow] 瑙嗛鏍煎瓙鎷栨嫿鏀剧疆锛岀储寮?', index)

  try {
    // 浼樺厛灏濊瘯鑾峰彇 JSON 鏍煎紡鐨勬嫋鎷芥暟鎹紙鏀寔浠庤棰戞牸瀛?鐢讳腑鐢绘嫋鎷斤級
    const jsonData = event.dataTransfer.getData('application/json')

    // 濡傛灉鏄粠瑙嗛鏍煎瓙鎷栨嫿杩囨潵鐨?
    if (jsonData) {
      const parsed = JSON.parse(jsonData)
      if (parsed.type === 'canvas') {
        // 浠庡叾浠栬棰戞牸瀛愭嫋鎷?- 鎵ц浜掓崲
        console.log(`[TeacherWindow] 浠庢牸瀛?${parsed.index} 鎷栨嫿鍒版牸瀛?${index}`)

        // 鑾峰彇鎷栨嫿鏉ユ簮鏍煎瓙鐨勬簮
        const sourceId = parsed.sourceId
        const targetSourceId = canvasSourceMap.value[index]

        // 馃幆 浣跨敤瀵硅薄灞曞紑瑙﹀彂鍝嶅簲寮忔洿鏂?
        const newMap = { ...canvasSourceMap.value }

        // 浜掓崲涓や釜鏍煎瓙鐨勬簮
        newMap[parsed.index] = targetSourceId || null
        newMap[index] = sourceId

        canvasSourceMap.value = newMap

        // 鏌ユ壘婧愬悕绉?
        const sourceInfo = allSources.value.find(s => s.id === sourceId)
        const targetInfo = allSources.value.find(s => s.id === targetSourceId)

        ElMessage.success(`宸蹭簰鎹?${sourceInfo?.name || '瑙嗛'} 鍜?${targetInfo?.name || '绌轰綅'}`)
        return
      }
    }

    // 鑾峰彇淇″彿婧愭暟鎹?
    const sourceId = event.dataTransfer?.getData('sourceId')
    const sourceType = event.dataTransfer?.getData('sourceType')
    const sourceName = event.dataTransfer?.getData('sourceName')

    console.log('[TeacherWindow] 鎷栨嫿鏁版嵁:', { sourceId, sourceType, sourceName })

    if (!sourceId) {
      console.warn('[TeacherWindow] 娌℃湁鎵惧埌淇″彿婧怚D')
      return
    }

    // 浠?allSources 涓煡鎵句俊鍙锋簮
    const source = allSources.value.find(s => s.id === sourceId)

    if (!source) {
      console.error('[TeacherWindow] 鏈壘鍒颁俊鍙锋簮:', sourceId)
      ElMessage.error('鏈壘鍒颁俊鍙锋簮')
      return
    }

    // 馃幆 鍏抽敭淇锛氱洿鎺ヨ皟鐢?handleDrop 澶勭悊鏀剧疆
    if (typeof handleDrop === 'function') {
      handleDrop({ ...source, dataTransfer: {} }, index)
    } else {
      console.error('[TeacherWindow] handleDrop 鏂规硶涓嶅瓨鍦?)
      ElMessage.error('鎷栨嫿鍔熻兘涓嶅彲鐢?)
    }
  } catch (error) {
    console.error('[TeacherWindow] 澶勭悊瑙嗛鎷栨嫿澶辫触:', error)
    ElMessage.error('鎷栨嫿澶辫触: ' + error.message)
  }
}

