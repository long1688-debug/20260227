// 馃幆 娣诲姞鍒伴瑙堝尯鍩?
const handleAddToPreview = (source) => {
  console.log('[TeacherWindow] 娣诲姞鍒伴瑙堝尯鍩?', source.name, source.id)
  try {
    // 妫€鏌ユ槸鍚﹀凡缁忓湪棰勮鏉′腑
    const existsInPreviews = videoPreviews.value.find(s => s.id === source.id)
    if (existsInPreviews) {
      ElMessage.warning(`${source.name} 宸插湪棰勮鍖哄煙涓璥)
      return
    }

    console.log('[TeacherWindow] 姝ラ1: 鏇存柊 sourceStore 涓殑淇″彿婧愮姸鎬?)
    // 鏇存柊 sourceStore 涓殑淇″彿婧愮姸鎬?
    const updateResult = sourceStore.updateSource(source.id, { addedToPreview: true })
    console.log('[TeacherWindow] updateSource 缁撴灉:', updateResult)
    console.log('[TeacherWindow] sourcePreviewStatus 褰撳墠鍊?', sourceStore.sourcePreviewStatus[source.id])
    console.log('[TeacherWindow] previewSources 鏁伴噺:', sourceStore.previewSources.length)

    console.log('[TeacherWindow] 姝ラ2: 灏嗕俊鍙锋簮娣诲姞鍒?videoPreviews 棰勮鏉?)
    // 灏嗕俊鍙锋簮娣诲姞鍒?videoPreviews 棰勮鏉?
    addVideoSource(source)
    console.log('[TeacherWindow] videoPreviews 鏁伴噺:', videoPreviews.value.length)

    // 馃幆 鐢ㄦ埛闇€姹傦細鎽勫儚澶村厛娣诲姞鍒伴瑙堝尯鍩燂紝鐢辩敤鎴锋墜鍔ㄦ嫋鏇冲埌鐢诲竷
    // 涓嶈嚜鍔ㄦ槧灏勫埌鐢诲竷鏍煎瓙锛屼繚鎸佺敤鎴锋帶鍒?
    ElMessage.success(`淇″彿婧?"${source.name}" 宸叉坊鍔犲埌棰勮鍖哄煙锛屽彲鎷栨洺鍒扮敾甯冩牸瀛恅)
  } catch (error) {
    console.error('[TeacherWindow] 娣诲姞鍒伴瑙堝け璐?', error)
    ElMessage.error('娣诲姞鍒伴瑙堝尯鍩熷け璐?)
  }
}

// 馃幆 浠庨瑙堝尯鍩熺Щ闄?
const handleRemoveFromPreview = (sourceId) => {
  console.log('[TeacherWindow] 浠庨瑙堝尯鍩熺Щ闄?', sourceId)
  try {
    const source = allSources.value.find(s => s.id === sourceId)
    if (!source) {
      ElMessage.error('鏈壘鍒颁俊鍙锋簮')
      return
    }

    // 浠庣敾甯冧腑绉婚櫎
    const canvasIndex = Object.keys(canvasSourceMap.value).find(index =>
      canvasSourceMap.value[index] === sourceId
    )

    if (canvasIndex !== undefined) {
      // 馃幆 娉ㄩ攢浠庡睘瑙嗛鍚屾
      unregisterSlaveVideo(parseInt(canvasIndex), sourceId)
      delete canvasSourceMap.value[canvasIndex]
      console.log(`[TeacherWindow] 宸蹭粠鐢诲竷 ${canvasIndex} 绉婚櫎: ${source.name}`)
    }

    // 馃幆 娓呯悊涓绘帶瑙嗛鍚屾
    clearMasterVideo(sourceId)

    // 浠?videoPreviews 涓Щ闄?
    removeVideoSource(sourceId)

    // 馃幆 浣跨敤 sourceStore 鏇存柊 addedToPreview 鐘舵€侊紙淇濈暀鍦ㄤ俊鍙锋簮鍒楄〃锛?
    sourceStore.updateSource(sourceId, { addedToPreview: false })
    console.log(`[TeacherWindow] 宸茶缃?addedToPreview = false: ${source.name}`)

    ElMessage.success(`宸蹭粠棰勮鍖哄煙绉婚櫎 "${source.name}"锛屼俊鍙锋簮鍒楄〃淇濈暀`)
  } catch (error) {
    console.error('[TeacherWindow] 浠庨瑙堢Щ闄ゅけ璐?', error)
    ElMessage.error('绉婚櫎澶辫触')
  }
}

// 馃幆 鍒犻櫎淇″彿婧?
const handleDeleteSource = (sourceId) => {
  console.log('[TeacherWindow] 鍒犻櫎淇″彿婧?', sourceId)
  try {
    const source = allSources.value.find(s => s.id === sourceId)
    if (!source) {
      ElMessage.error('鏈壘鍒颁俊鍙锋簮')
      return
    }

    // 馃幆 濡傛灉宸叉坊鍔犲埌棰勮锛屽厛浠庨瑙堝尯鍩熺Щ闄?
    if (source.addedToPreview) {
      // 浠庣敾甯冧腑绉婚櫎锛堝鏋滃湪鐢诲竷涓級
      const canvasIndex = Object.keys(canvasSourceMap.value).find(index =>
        canvasSourceMap.value[index] === sourceId
      )

      if (canvasIndex !== undefined) {
        // 馃幆 娉ㄩ攢浠庡睘瑙嗛鍚屾
        unregisterSlaveVideo(parseInt(canvasIndex), sourceId)
        delete canvasSourceMap.value[canvasIndex]
        console.log(`[TeacherWindow] 宸蹭粠鐢诲竷 ${canvasIndex} 绉婚櫎: ${source.name}`)
      }

      // 馃幆 娓呯悊涓绘帶瑙嗛鍚屾
      clearMasterVideo(sourceId)

      // 浠?videoPreviews 涓Щ闄?
      removeVideoSource(sourceId)
    }

    // 浠?sourceStore 涓Щ闄?
    sourceStore.removeSource(sourceId)

    ElMessage.success(`宸插垹闄や俊鍙锋簮 "${source.name}"`)
  } catch (error) {
    console.error('[TeacherWindow] 鍒犻櫎淇″彿婧愬け璐?', error)
    ElMessage.error('鍒犻櫎淇″彿婧愬け璐?)
  }
}

// 鎻愪氦鏂颁俊鍙锋簮琛ㄥ崟
const handleSubmitNewSource = async (formData) => {
  console.log('[TeacherWindow] 鎻愪氦鏂颁俊鍙锋簮琛ㄥ崟:', formData)

  try {
    // 鐢熸垚鍞竴ID
    const sourceId = 'source_' + Date.now() + '_' + Math.random().toString(36).substr(2, 9)

    // 鏍规嵁绫诲瀷鍒涘缓婧愬璞?
    let newSource = {
      id: sourceId,
      name: formData.name || `鏂颁俊鍙锋簮_${sourceId.slice(-6)}`,
      type: formData.type,
      status: 'online',
      addedToPreview: true,  // 馃幆 鏍囪涓鸿嚜鍔ㄦ坊鍔犲埌棰勮鍖哄煙
      createdAt: new Date().toISOString()
    }

    // 鏍规嵁涓嶅悓绫诲瀷璁剧疆鐗瑰畾灞炴€?
    if (formData.type === 'localCamera') {
      newSource.deviceId = formData.deviceId
      newSource.resolution = '1920x1080'
      newSource.fps = 30

      // 馃幆 鍏抽敭淇锛氱珛鍗宠幏鍙栨憚鍍忓ご鐨?MediaStream
      try {
        console.log('[TeacherWindow] 姝ｅ湪鑾峰彇鎽勫儚澶存祦:', formData.deviceId)
        const constraints = {
          video: formData.deviceId ? { deviceId: formData.deviceId } : true,
          audio: true
        }
        const stream = await navigator.mediaDevices.getUserMedia(constraints)
        newSource.stream = stream
        console.log('[TeacherWindow] 鎽勫儚澶存祦鑾峰彇鎴愬姛:', stream.id)
      } catch (error) {
        console.error('[TeacherWindow] 鑾峰彇鎽勫儚澶存祦澶辫触:', error)
        ElMessage.error('鏃犳硶璁块棶鎽勫儚澶? ' + error.message)
        return // 缁堟娣诲姞娴佺▼
      }
    } else if (formData.type === 'captureCard') {
      newSource.deviceId = formData.deviceId
      newSource.resolution = formData.resolution
      newSource.interfaceType = formData.inputInterface
      newSource.fps = 30
    } else if (formData.type === 'documentScanner') {
      newSource.deviceId = formData.deviceId
      newSource.scanMode = formData.scanMode
      newSource.autoEnhance = formData.autoEnhance
      newSource.autoCrop = formData.autoCrop
      newSource.resolution = '1920x1080'
    } else if (formData.type === 'networkCamera') {
      newSource.protocol = formData.protocol
      newSource.streamUrl = formData.streamUrl
      // ONVIF鐩稿叧瀛楁
      if (formData.protocol === 'onvif') {
        newSource.onvifUrl = formData.onvifUrl
      }
      newSource.needAuth = formData.needAuth
      newSource.username = formData.username
      newSource.password = formData.password
      newSource.resolution = '1920x1080'
    } else if (formData.type === 'networkStream') {
      newSource.protocol = formData.protocol
      newSource.streamUrl = formData.streamUrl
      newSource.bufferTime = formData.bufferTime
      newSource.needAuth = formData.needAuth
      newSource.authToken = formData.authToken
    }

    console.log('[TeacherWindow] 鍒涘缓鏂颁俊鍙锋簮:', newSource)

    // 馃幆 淇濆瓨鍒?sourceStore
    sourceStore.addSource(newSource)

    // 馃幆 绔嬪嵆娣诲姞鍒伴瑙堝尯鍩?
    await nextTick()
    handleAddToPreview(newSource)

    showAddSourceDialog.value = false

  } catch (error) {
    console.error('[TeacherWindow] 娣诲姞淇″彿婧愬け璐?', error)
    ElMessage.error('娣诲姞淇″彿婧愬け璐? ' + error.message)
  }
}

// 鎻愪氦閲嶅懡鍚?
const handleRenameSource = (sourceId, newName) => {
  console.log('[TeacherWindow] 閲嶅懡鍚嶄俊鍙锋簮:', { sourceId, newName })

  try {
    if (!newName || newName.trim() === '') {
      ElMessage.warning('淇″彿婧愬悕绉颁笉鑳戒负绌?)
      return
    }

    const sourceIndex = videoPreviews.value.findIndex(s => s.id === sourceId)
    if (sourceIndex !== -1) {
      const oldName = videoPreviews.value[sourceIndex].name
      videoPreviews.value[sourceIndex].name = newName.trim()
      console.log(`[TeacherWindow] 淇″彿婧愬凡閲嶅懡鍚? "${oldName}" -> "${newName}"`)

      ElMessage.success(`淇″彿婧?"${newName}" 閲嶅懡鍚嶆垚鍔焋)

      showRenameSourceDialog.value = false
      renameSourceTarget.value = null
    } else {
      ElMessage.error('鏈壘鍒拌閲嶅懡鍚嶇殑淇″彿婧?)
    }
  } catch (error) {
    console.error('[TeacherWindow] 閲嶅懡鍚嶄俊鍙锋簮澶辫触:', error)
    ElMessage.error('閲嶅懡鍚嶄俊鍙锋簮澶辫触')
  }
}

// ============================================
// SourcePreviewBar 浜嬩欢澶勭悊鍑芥暟
// ============================================

// 鍒犻櫎淇″彿婧?
const handleRemoveSource = (source) => {
  console.log('[TeacherWindow] 鍒犻櫎淇″彿婧?', source.name, source.id)
  try {
    const sourceIndex = videoPreviews.value.findIndex(s => s.id === source.id)
    if (sourceIndex !== -1) {
      // 馃幆 鍏堜粠 canvasSourceMap 涓Щ闄ゆ槧灏勫叧绯?
      Object.keys(canvasSourceMap.value).forEach(key => {
        if (canvasSourceMap.value[key] === source.id) {
          delete canvasSourceMap.value[key]
          console.log('[TeacherWindow] 宸蹭粠 canvasSourceMap 绉婚櫎鏄犲皠:', key, '->', source.id)
        }
      })

      // 鉁?鐩存帴浣跨敤瑙ｆ瀯鐨?removeVideoSource 鍑芥暟
      if (typeof removeVideoSource === 'function') {
        removeVideoSource(source.id)
        console.log('[TeacherWindow] 宸查€氳繃 removeVideoSource 娓呯悊婧?', source.id)
      } else {
        // 闄嶇骇鏂规锛氭墜鍔ㄧЩ闄?
        videoPreviews.value.splice(sourceIndex, 1)
      }

      ElMessage.success(`宸插垹闄や俊鍙锋簮 "${source.name}"`)
    }
  } catch (error) {
    console.error('[TeacherWindow] 鍒犻櫎淇″彿婧愬け璐?', error)
    ElMessage.error('鍒犻櫎淇″彿婧愬け璐?)
  }
}

