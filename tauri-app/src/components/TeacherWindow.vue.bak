// 瀵煎嚭瀛楀箷锛堟牴鎹牸寮忥級
const exportSubtitles = async () => {
  try {
    exporting.value = true

    let content = ''
    let filename = `subtitles_${Date.now()}`
    let mimeType = 'text/plain'

    switch (exportFormat.value) {
      case 'srt':
        content = exportToSRT()
        filename += '.srt'
        mimeType = 'text/plain'
        break
      case 'json':
        content = exportToJSON()
        filename += '.json'
        mimeType = 'application/json'
        break
      case 'txt':
        content = exportToTXT()
        filename += '.txt'
        mimeType = 'text/plain'
        break
    }

    exportPreview.value = content

    // 鍒涘缓涓嬭浇閾炬帴
    const blob = new Blob([content], { type: mimeType })
    const url = URL.createObjectURL(blob)
    const link = document.createElement('a')
    link.href = url
    link.download = filename
    link.click()
    URL.revokeObjectURL(url)

    ElMessage.success(`瀛楀箷宸插鍑轰负 ${exportFormat.value.toUpperCase()} 鏍煎紡`)
  } catch (error) {
    console.error('[TeacherWindow] 瀵煎嚭瀛楀箷澶辫触:', error)
    ElMessage.error('瀵煎嚭澶辫触: ' + error.message)
  } finally {
    exporting.value = false
  }
}

// 瀵煎嚭涓?SRT 鏍煎紡
const exportToSRT = () => {
  let srtContent = ''
  let globalIndex = 1

  generatedSubtitles.value.forEach(videoSub => {
    if (videoSub.subtitles) {
      videoSub.subtitles.forEach(sub => {
        srtContent += `${globalIndex}\n`
        srtContent += `${sub.startTime} --> ${sub.endTime}\n`
        srtContent += `${sub.text}\n\n`
        globalIndex++
      })
    }
  })

  return srtContent
}

// 瀵煎嚭涓?JSON 鏍煎紡
const exportToJSON = () => {
  return JSON.stringify(generatedSubtitles.value, null, 2)
}

// 瀵煎嚭涓?TXT 鏍煎紡
const exportToTXT = () => {
  let txtContent = ''

  generatedSubtitles.value.forEach(videoSub => {
    if (videoSub.subtitles) {
      txtContent += `=== ${videoSub.videoName} ===\n`
      videoSub.subtitles.forEach(sub => {
        txtContent += `[${sub.startTime}] ${sub.text}\n`
      })
      txtContent += '\n'
    }
  })

  return txtContent
}

