import { listCaptureDevices, filterCaptureCards, filterDocumentScanners } from '@/services/captureDeviceService'
import { speechRecognition } from '@/services/subtitleService'

// 馃幆 鎻愬墠鍒濆鍖?stores锛堢敤浜?window.__sourceStore 鍜?window.__canvasStore锛?
const studentStore = useStudentStore()
const taskStore = useTaskStore()
const visionStore = useVisionStore()
const sourceStore = useSourceStore()
const canvasStore = useCanvasStore()
const subtitleStore = useSubtitleStore()
const audioStore = useAudioStore()
const liveStreamingStore = useLiveStreamingStore()
const mediaStore = useMediaStore()
const videoSourceManager = useVideoSourceManager()

// ============================================
// 馃啎 TTS 璇煶鎾姤鍒濆鍖?
// ============================================
const tts = useTTSAnnouncements()

// ============================================
// 馃啎 娓叉煋寮曟搸鐩稿叧鐘舵€侊紙蹇呴』鍦?useSourceDrag 涔嬪墠瀹氫箟锛?
// ============================================
const renderEngineRef = ref(null) // 娓叉煋寮曟搸缁勪欢寮曠敤
const selectedCameraId = ref('') // 褰撳墠閫変腑鐨勬憚鍍忓ごID
const activeSources = ref([]) // 娲昏穬鐨勮棰戞簮鍒楄〃
const renderLayoutType = ref('single') // 褰撳墠娓叉煋甯冨眬绫诲瀷
const isDrawingMode = ref(false) // 鏄惁澶勪簬缁樺埗妯″紡
 const useRenderEngine = ref(true) // 鏄惁鍚敤娓叉煋寮曟搸瑕嗙洊妯″紡锛岄粯璁や负true

// ============================================
// 鍒濆鍖栨牳蹇?Composables
// ============================================
const {
  // 褰曞埗鐩稿叧
  recordingConfig,
  audioChannels,
  recordings,
  recordingTemplates,
  sourceRecordingState,
  canvasRecordingStates,
  previewRecordingStates,
  currentRecordingSession,
  showPlaybackDialog,
  showRecordingDialog,
  playbackVideoRef,
  recordingFilter,

  // 澶氭満浣嶅姛鑳?
  startMulticamRecording,
  stopMulticamRecording,
  activeCameraIndex,
  switchCamera,

  // VR/360掳瑙嗛鍔熻兘
  vrRecordingState,
  startVrRecording,
  stopVrRecording,

  // 闊抽绠＄悊
  toggleNoiseReduction,
  setChannelEnabled,

  // 妯℃澘绠＄悊
  loadTemplates: loadRecordingTemplates,
