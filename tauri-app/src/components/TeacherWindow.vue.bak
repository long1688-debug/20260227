  deleteTemplate: deleteRecordingTemplate,

  // 鐢诲竷褰曞埗鎺у埗
  startAllCanvasRecording,
  pauseAllCanvasRecording,
  stopAllCanvasRecording,
  resumeAllCanvasRecording,

  // 褰曞埗鏂囦欢绠＄悊
  loadRecordings: loadRecordingsFromComposable,
  deleteRecording: deleteRecordingFromComposable
} = useRecording()

const {
  // 瑙嗛鍚屾鐩稿叧
  currentLayout,
  pipVisible,
  pipPosition,
  changeLayout,
  togglePip,
  addVideoSource,
  removeVideoSource,
  setVideoPreviewRef,
  setCanvasSource,
  videoPreviews,
  canvasSourceMap,
  videoPreviewRefs,
  // 馃幆 瑙嗛鍚屾璋冪敤鍑芥暟
  registerMasterVideo,
  registerSlaveVideo,
  unregisterSlaveVideo,
  clearMasterVideo,
  checkAudioSync,
  getSyncStatus,
  addSource: addSourceToVideoSync  // 鑾峰彇useVideoSync鐨刟ddSource鍑芥暟
} = useVideoSync()

// 馃幆 鍒濆鍖栧竷灞€鐘舵€佺鐞?- 纭繚 window.__layoutStates 琚纭缃?
const { layoutStates, assignSource, saveToStorage } = useLayoutStates()

// 馃幆 纭繚 window.__layoutStates 宸插垵濮嬪寲
if (typeof window !== 'undefined' && !window.__layoutStates) {
  window.__layoutStates = layoutStates
  console.log('[TeacherWindow] 鍒濆鍖?window.__layoutStates')
}

// 馃幆 纭繚 window.__sourceStore 宸插垵濮嬪寲锛堢敤浜庤幏鍙栦俊鍙锋簮绫诲瀷锛?
if (typeof window !== 'undefined' && !window.__sourceStore) {
  window.__sourceStore = sourceStore
  console.log('[TeacherWindow] 鍒濆鍖?window.__sourceStore')
}

const {
  // 缃戠粶鐩戞帶鐩稿叧
  networkQuality,
  startNetworkMonitoring: startNetworkMonitor,
  stopNetworkMonitoring: stopNetworkMonitor
} = useNetworkMonitor()

const {
  // 闊抽鐩戞帶鐩稿叧
  audioLevels,
  startAudioMonitor,
  stopAudioMonitor
} = useAudioMonitor()

const {
  // 璁剧疆鐩稿叧
  settings,
  showSettingsDialog,
  loadSettings,
  saveSettings,
  resetSettings
} = useSettings()

// ============================================
// 鍒濆鍖?Pinia Stores
// ============================================
// Stores 宸插湪涓婃柟鎻愬墠鍒濆鍖?

// ============================================
// 馃啎 璁稿彲璇侀獙璇佺浉鍏崇姸鎬?
// ============================================
const licenseVerified = ref(false) // 璁稿彲璇佹槸鍚﹀凡楠岃瘉閫氳繃

// 馃幆 淇″彿婧愭嫋鎷界鐞嗭紙鏀寔浠庨瑙堝尯鎷栨嫿鍒扮敾甯冪綉鏍硷級
// 馃幆 淇锛氶噸鍛藉悕瑙ｆ瀯浠ラ伩鍏嶄笌 useVideoSync 鍐茬獊
const {
  dragOverIndex,
  draggedSourceType,
  isDraggingSource,
  currentSelectedSource,
  canvasSourceMap: dragCanvasSourceMap,  // 馃幆 閲嶅懡鍚嶉伩鍏嶅啿绐?
  videoPreviews: dragVideoPreviews,  // 馃幆 淇锛氶噸鍛藉悕瑙ｆ瀯浠ラ伩鍏嶄笌 useVideoSync 鍐茬獊
  handleMouseDown,
  handleMouseMove,
  handleMouseUp,
  handleDrop,
  setCurrentSelectedSource,
  setVideoPreviews,
  cloneSourceForCanvas  // 馃幆 鏂板锛氬鍑哄厠闅嗗嚱鏁?
} = useSourceDrag({
  // 馃幆 鍏抽敭淇锛氫紶閫?canvasSourceMap锛岀‘淇濇嫋鎷芥洿鏂扮殑鏄纭殑鏄犲皠
  canvasSourceMap,
  saveLayoutMap: saveToStorage,
  assignSource,
  currentLayout,
  allSources: sourceStore.sources,  // 浼犻€掓墍鏈夋簮缁檜seSourceDrag
  renderEngineRef,  // 馃幆 浼犻€掓覆鏌撳紩鎿庡紩鐢紝鐢ㄤ簬Canvas鎷栨嫿妫€娴?
  addSourceToGlobalList: (source) => {
    // 灏嗗厠闅嗙殑婧愭坊鍔犲埌婧愬瓨鍌ㄤ腑
    if (!sourceStore.sources.some(s => s.id === source.id)) {
      sourceStore.sources.push(source);
      console.log(`[TeacherWindow] 宸插皢鍏嬮殕婧愭坊鍔犲埌鍏ㄥ眬鍒楄〃: ${source.name} (${source.id})`);
    }

    // 鍚屾椂灏嗗厠闅嗙殑婧愭坊鍔犲埌useVideoSync鐨勬簮鍒楄〃涓?
    if (typeof addSourceToVideoSync === 'function') {
      addSourceToVideoSync(source);
      console.log(`[TeacherWindow] 宸插皢鍏嬮殕婧愭坊鍔犲埌VideoSync鍒楄〃: ${source.name} (${source.id})`);
    }
  }
})


// ============================================
// 鎷栨嫿浜嬩欢澶勭悊鍑芥暟锛堜緵 VideoSection 璋冪敤锛?
// ============================================
const onDragOver = (event, index) => {
  if (typeof handleMouseDown === 'function') {
    // 浣跨敤 handleMouseDown 鍐呴儴鐨勬嫋鎷介€昏緫
  }
  dragOverIndex.value = index
}

const onDragLeave = (event) => {
  dragOverIndex.value = null
}

const onDrop = (event, index) => {
  if (typeof handleDrop === 'function') {
    const source = {
      id: event?.dataTransfer?.getData('sourceId') || `drop_${Date.now()}`,
      type: event?.dataTransfer?.getData('sourceType') || 'localVideo',
      name: event?.dataTransfer?.getData('sourceName') || 'Dropped Source'
    }
    handleDrop(event, index)
  }
}

// ============================================
// 璁剧疆瀵硅瘽妗嗙浉鍏崇姸鎬?
// ============================================
const settingsActiveTab = ref('recording')
const customVideoBitrate = ref(0)
const customLiveBitrate = ref(0)

// ============================================
// 淇″彿婧愮鐞嗙浉鍏崇姸鎬?
// ============================================
// 馃幆 淇锛歛llSources 搴旇浠?sourceStore 鍚屾鑾峰彇
const allSources = computed(() => {
  return sourceStore.sources.map(source => ({
    ...source,
    // 纭繚 addedToPreview 灞炴€у瓨鍦?
    addedToPreview: source.addedToPreview || false
  }))
})

// 灏嗙敾甯冩簮鏄犲皠杞崲涓烘覆鏌撳紩鎿庢墍闇€鐨勬牸寮?
const mappedRenderSources = computed(() => {
  if (!useRenderEngine.value) return []

  const sources = []

  // 鏍规嵁canvasSourceMap鏄犲皠锛屽皢褰撳墠甯冨眬鐨勬簮杞崲涓烘覆鏌撳紩鎿庢牸寮?
  const validIndices = getVisibleCanvasIndices(currentLayout.value)

  validIndices.forEach(index => {
    const sourceId = canvasSourceMap.value[index]
    if (sourceId) {
      const source = allSources.value.find(s => s.id === sourceId)
      if (source) {
        // 杞崲涓烘覆鏌撳紩鎿庨渶瑕佺殑鏍煎紡
        sources.push({
          id: source.id,
          name: source.name,
          type: mapSourceType(source.type), // 鏄犲皠鍒版覆鏌撳紩鎿庢敮鎸佺殑绫诲瀷
          url: source.url,
          deviceId: source.deviceId,
          stream: source.stream,
          properties: source.properties || {}
        })
      }
    }
  })

  return sources
})

// 灏嗙敾甯冩簮鏄犲皠杞崲涓篤ideoGrid鎵€闇€鐨勬牸寮?
const mappedCanvasSources = computed(() => {
  // 淇濇寔鍘熸湁鐨勬槧灏勯€昏緫锛岀敤浜庡吋瀹圭洰鐨勶紙褰搖seRenderEngine涓篺alse鏃讹級
  return allSources.value.filter(source => {
    // 妫€鏌ヨ繖涓簮鏄惁鍦ㄥ綋鍓嶅竷灞€鐨刢anvasSourceMap涓?
    return Object.values(canvasSourceMap.value).some(id => id === source.id)
  })
})

const currentPage = ref(1)
const pageSize = ref(6) // 姣忛〉鏄剧ず 6 涓俊鍙锋簮
const previewVideoRefs = ref([]) // 婧愰瑙堢獥鍙ｈ棰戝紩鐢?

// 灏嗘簮绫诲瀷鏄犲皠鍒版覆鏌撳紩鎿庢敮鎸佺殑绫诲瀷
const mapSourceType = (sourceType) => {
  const typeMap = {
    'localVideo': 'video',
    'localDevice': 'camera',
    'networkCamera': 'netcam',
    'remoteDesktop': 'desktop',
    'screenShare': 'screen',
    'localCamera': 'camera',
    'ppt': 'web',
    'pptx': 'web',
    'word': 'web',
    'doc': 'web',
    'docx': 'web',
    'pdf': 'web'
  }

  return typeMap[sourceType] || 'video'
}

// 灏嗗竷灞€缂栧彿杞崲涓烘覆鏌撳紩鎿庢敮鎸佺殑甯冨眬绫诲瀷
const convertLayoutType = (layoutNum) => {
  const layoutMap = {
    1: 'single',           // 1鍒嗗睆
    2: 'grid-1x2',         // 2鍒嗗睆
    3: 'grid-3-special',   // 3鍒嗗睆锛堝乏浜屽彸涓€锛?
    4: 'grid-2x2',         // 4鍒嗗睆
    5: 'grid-2x3',         // 6鍒嗗睆
    7: 'grid-3x3',         // 9鍒嗗睆
    10: 'grid-4x4',        // 16鍒嗗睆
    11: 'grid-5x5',        // 25鍒嗗睆
    12: 'grid-6x6',        // 36鍒嗗睆
    13: 'grid-7x7',        // 49鍒嗗睆
    14: 'special-1',       // 鐗规畩甯冨眬1锛堝皬鐨勫乏涓婅锛?
    15: 'special-2',       // 鐗规畩甯冨眬2锛堝皬鐨勫乏涓嬭锛?
    16: 'special-3',       // 鐗规畩甯冨眬3锛堝皬鐨勫彸涓婅锛?
    17: 'special-4',       // 鐗规畩甯冨眬4锛堝皬鐨勫彸涓嬭锛?
    18: 'free'             // 鑷敱甯冨眬
  }

  return layoutMap[layoutNum] || 'single'
}

// 灏嗘覆鏌撳紩鎿庣殑甯冨眬绫诲瀷杞崲涓哄竷灞€绱㈠紩锛堝弽鍚戣浆鎹級
const convertLayoutTypeToIndex = (layoutType) => {
  const layoutMap = {
    'single': 1,           // 1鍒嗗睆
    'grid-1x2': 2,         // 2鍒嗗睆
    'grid-3-special': 3,   // 3鍒嗗睆锛堝乏浜屽彸涓€锛?
    'grid-2x2': 4,         // 4鍒嗗睆
    'grid-2x3': 5,         // 6鍒嗗睆
    'grid-3x3': 7,         // 9鍒嗗睆
    'grid-4x4': 10,        // 16鍒嗗睆
    'grid-5x5': 11,        // 25鍒嗗睆
    'grid-6x6': 12,        // 36鍒嗗睆
    'grid-7x7': 13,        // 49鍒嗗睆
    'special-1': 14,       // 鐗规畩甯冨眬1锛堝皬鐨勫乏涓婅锛?
    'special-2': 15,       // 鐗规畩甯冨眬2锛堝皬鐨勫乏涓嬭锛?
    'special-3': 16,       // 鐗规畩甯冨眬3锛堝皬鐨勫彸涓婅锛?
    'special-4': 17,       // 鐗规畩甯冨眬4锛堝皬鐨勫彸涓嬭锛?
    'free': 18             // 鑷敱甯冨眬
  }

  return layoutMap[layoutType] || 1
}

// 鑾峰彇甯冨眬鏄剧ず鍚嶇О锛堢敤浜庢秷鎭彁绀猴級
