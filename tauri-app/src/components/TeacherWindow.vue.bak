  // 鍒濆鍖栬瑙夊垎鏋愭暟鎹?
  if (analysisResults.value.length === 0) {
    analysisResults.value = [
      { id: 'A001', studentName: '寮犱笁', type: '涓撴敞搴', focus: 85, emotion: '涓撴敞', behavior: '绉瀬鍙備笌', time: '13:30' },
