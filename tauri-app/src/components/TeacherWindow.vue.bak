// 棰勫姞杞?YOLO 妯″瀷
const preloadYolo = async () => {
  try {
    ElMessage.info('姝ｅ湪鍔犺浇 YOLO 妯″瀷锛岃绋嶅€?..')
    const success = await visionStore.preloadYoloModel()
    updateDetectionMode()

    if (success) {
      ElMessage.success('YOLO 妯″瀷鍔犺浇瀹屾垚锛屽綋鍓嶆ā寮? ' + getDetectionModeText.value.icon + ' ' + getDetectionModeText.value.text)
    } else {
      ElMessage.error('YOLO 妯″瀷鍔犺浇澶辫触')
    }
    return success
  } catch (error) {
    console.error('[TeacherWindow] YOLO 棰勫姞杞藉け璐?', error)
    ElMessage.error('YOLO 妯″瀷鍔犺浇澶辫触: ' + error.message)
    return false
  }
}

// 寮€濮嬭瑙夊垎鏋?
const startAnalysis = async () => {
  if (isAnalyzing.value) {
    ElMessage.warning('鍒嗘瀽姝ｅ湪杩涜涓?)
    return
  }

  try {
    // 棰勫姞杞?YOLO 妯″瀷
    const loaded = await preloadYolo()
    if (!loaded) {
      return
    }

    // 璁剧疆妫€娴嬮槇鍊?
    visionStore.setConfig({ yoloThreshold: 0.6 })

    // 鑾峰彇瑙嗛鍏冪礌
    const videoElement = playbackVideoRef.value
    if (!videoElement) {
      ElMessage.error('鏈壘鍒拌棰戝厓绱?)
      return
    }

    // 寮€濮嬪垎鏋?
    isAnalyzing.value = true
    ElMessage.success('瑙嗚鍒嗘瀽宸插紑濮?)

    // 鎸佺画鍒嗘瀽瑙嗛甯?
    const analyzeLoop = async () => {
      if (!isAnalyzing.value) return

      try {
        const canvas = document.createElement('canvas')
        canvas.width = videoElement.videoWidth || 640
        canvas.height = videoElement.videoHeight || 480
        const ctx = canvas.getContext('2d')

        if (videoElement.readyState >= 2) {
          ctx.drawImage(videoElement, 0, 0, canvas.width, canvas.height)
          await visionStore.analyzeFrame(canvas)
        }
      } catch (error) {
        console.error('[TeacherWindow] 甯у垎鏋愬け璐?', error)
      }

      // 姣?500ms 鍒嗘瀽涓€娆?
      if (isAnalyzing.value) {
        setTimeout(analyzeLoop, 500)
      }
    }

    analyzeLoop()
  } catch (error) {
    console.error('[TeacherWindow] 鍚姩鍒嗘瀽澶辫触:', error)
    ElMessage.error('鍚姩鍒嗘瀽澶辫触: ' + error.message)
    isAnalyzing.value = false
  }
}

// 鍋滄瑙嗚鍒嗘瀽
const stopAnalysis = () => {
  isAnalyzing.value = false
  visionStore.stopAnalysis()
  ElMessage.info('瑙嗚鍒嗘瀽宸插仠姝?)
}

// 鏇存柊妫€娴嬫ā寮忕姸鎬?
const updateDetectionMode = () => {
  detectionMode.value = visionStore.detectionMode || 'online'
  networkStatus.value = visionStore.isOnline !== undefined ? visionStore.isOnline : navigator.onLine
}

// 閲嶈浇 YOLO 妯″瀷
