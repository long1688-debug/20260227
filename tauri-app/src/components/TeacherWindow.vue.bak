// 鎾斁褰曞埗鏂囦欢
const playRecording = async (recording) => {
  try {
    console.log('[TeacherWindow] 鎾斁褰曞埗:', recording)
    playbackVideoUrl.value = recording.url || recording.path
    showPlaybackDialog.value = true

    await nextTick()
    if (playbackVideoRef.value) {
      playbackVideoRef.value.src = playbackVideoUrl.value
      await playbackVideoRef.value.play().catch(err => {
        console.warn('[TeacherWindow] 鑷姩鎾斁琚樆姝?, err)
      })
    }
  } catch (error) {
    console.error('[TeacherWindow] 鎾斁褰曞埗鏂囦欢澶辫触:', error)
    ElMessage.error('鎾斁澶辫触')
  }
}

// 瀵煎嚭褰曞埗鏂囦欢
const exportRecording = async (recording) => {
  try {
    console.log('[TeacherWindow] 瀵煎嚭褰曞埗:', recording)

    const { ElMessageBox } = await import('element-plus')
    await ElMessageBox.confirm(
      `纭畾瀵煎嚭褰曞埗鏂囦欢 "${recording.name}" 鍚楋紵`,
      '瀵煎嚭纭',
      {
        confirmButtonText: '纭畾',
        cancelButtonText: '鍙栨秷',
        type: 'info'
      }
    )

    if (recording.path) {
      const link = document.createElement('a')
      link.href = recording.path
      link.download = recording.name
      link.click()
    }

    if (recording.url) {
      const response = await fetch(recording.url)
      const blob = await response.blob()
      const url = URL.createObjectURL(blob)

      const link = document.createElement('a')
      link.href = url
      link.download = recording.name
      link.click()

      URL.revokeObjectURL(url)
    }

    ElMessage.success('瀵煎嚭鎴愬姛')
  } catch (error) {
    if (error !== 'cancel') {
      console.error('[TeacherWindow] 瀵煎嚭澶辫触:', error)
      ElMessage.error('瀵煎嚭澶辫触: ' + error.message)
    }
  }
}

// 鍒犻櫎褰曞埗鏂囦欢
const deleteRecording = async (recording) => {
  try {
    console.log('[TeacherWindow] 鍒犻櫎褰曞埗:', recording)

    const { ElMessageBox } = await import('element-plus')
    await ElMessageBox.confirm(
      `纭畾鍒犻櫎褰曞埗鏂囦欢 "${recording.name}" 鍚楋紵 姝ゆ搷浣滀笉鍙仮澶嶃€俙,
      '鍒犻櫎纭',
      {
        confirmButtonText: '纭畾',
        cancelButtonText: '鍙栨秷',
        type: 'warning'
      }
    )

    if (typeof deleteRecordingFromComposable === 'function') {
      await deleteRecordingFromComposable(recording)
    } else {
      const index = recordings.value.findIndex(r => r.id === recording.id)
      if (index !== -1) {
        recordings.value.splice(index, 1)
      }
    }

    ElMessage.success('鍒犻櫎鎴愬姛')
  } catch (error) {
    if (error !== 'cancel') {
      console.error('[TeacherWindow] 鍒犻櫎澶辫触:', error)
      ElMessage.error('鍒犻櫎澶辫触: ' + error.message)
    }
  }
}

