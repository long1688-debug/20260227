  try {
    ElMessage.info('姝ｅ湪閲嶈浇 YOLO 妯″瀷...')
    await visionStore.resetYoloModel()
    updateDetectionMode()

    const mode = visionStore.detectionMode
    const modeText = {
      online: '馃寪 鍦ㄧ嚎妯″紡',
      local: '馃捑 鏈湴妯″紡',
      fallback: '鈿狅笍 闄嶇骇妯″紡'
    }

    ElMessage.success(`妯″瀷宸查噸杞斤紝褰撳墠妯″紡: ${modeText[mode] || mode}`)
  } catch (error) {
    console.error('[TeacherWindow] 閲嶈浇 YOLO 妯″瀷澶辫触:', error)
    ElMessage.error('閲嶈浇 YOLO 妯″瀷澶辫触')
  }
}

