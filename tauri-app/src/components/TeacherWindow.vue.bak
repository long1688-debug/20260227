// 娓叉煋鍏冪礌鍙屽嚮鍥炶皟 - 鍒囨崲鍏ㄥ睆
const onRenderElementDoubleClick = (e) => {
  console.log('[TeacherWindow] 娓叉煋鍏冪礌鍙屽嚮:', e.element.id)

  // 瑙ｆ瀽鍏冪礌ID鑾峰彇妲戒綅绱㈠紩
  const elementId = e.element.id
  const match = elementId.match(/\d+/)
  if (match) {
    const slotIndex = parseInt(match[0])

    // 濡傛灉褰撳墠鏈夋渶澶у寲鐨勭敾闈紝杩樺師瀹?
    if (maximizedIndex.value !== null) {
      console.log('[TeacherWindow] 杩樺師鍒嗗睆鏄剧ず')
      maximizedIndex.value = null
      isMaximized.value = false
    } else {
      // 鏈€澶у寲褰撳墠鐐瑰嚮鐨勭敾闈?
      console.log('[TeacherWindow] 鏈€澶у寲鐢婚潰:', slotIndex)
      maximizedIndex.value = slotIndex
      isMaximized.value = true
    }
  }
}

