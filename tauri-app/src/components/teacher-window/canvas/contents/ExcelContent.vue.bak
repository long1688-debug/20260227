<template>
  <div class="excel-content">
    <!-- 加载状态 -->
    <div v-if="isLoading" class="loading-state">
      <el-icon class="is-loading" :size="48"><Loading /></el-icon>
      <p>正在加载 Excel 表格...</p>
    </div>

    <!-- 错误状态 -->
    <div v-else-if="hasError" class="error-state">
      <el-icon :size="48"><WarningFilled /></el-icon>
      <p>Excel 文件解析失败</p>
      <small>{{ errorMessage || '请确保文件格式正确' }}</small>
      <el-button size="small" type="primary" style="margin-top: 12px" @click="retryLoad">
        重新加载
      </el-button>
    </div>

    <!-- Excel 内容(真实解析后) -->
    <div v-else-if="htmlContent" class="excel-container" v-html="htmlContent"></div>

    <!-- 🎯 占位符模式 - 显示兼容性信息 -->
    <div v-else class="placeholder">
      <el-icon :size="64"><Files /></el-icon>
      <h3 class="doc-title">{{ props.source?.name }}</h3>
      
      <!-- 🎯 兼容性级别提示 -->
      <div class="compatibility-banner" :class="`level-${compatibilityLevel}`">
        <el-icon :size="20"><InfoFilled /></el-icon>
        <span>{{ compatibilityMessage }}</span>
      </div>
      
      <!-- 功能说明 -->
      <div class="feature-info">
        <h4>📋 当前状态</h4>
        <ul>
          <li>✅ 文件已成功添加</li>
          <li>⏳ Excel 真实解析功能开发中</li>
          <li>💡 建议转换为 PDF 获得最佳预览效果</li>
        </ul>
      </div>
      
      <!-- 操作建议 -->
      <div class="action-suggestions">
        <el-button type="primary" size="small" @click="convertToPdf">
          <el-icon><Document /></el-icon>
          转换为 PDF (推荐)
        </el-button>
        <el-button size="small" @click="openInExternalApp">
          <el-icon><Right /></el-icon>
          用外部应用打开
        </el-button>
      </div>
      
      <p class="file-info">
        格式: .{{ fileExtension }} | 
        大小: {{ formatFileSize(props.source?.file?.size) }}
      </p>
    </div>
  </div>
</template>

<script setup>
import { ref, computed, watch } from 'vue';
import { Files, Loading, WarningFilled, InfoFilled, Document, Right } from '@element-plus/icons-vue';
import { ElMessage } from 'element-plus';
import { checkFormatCompatibility, generateUserWarning } from '@/utils/documentTypeDetector';

const props = defineProps({
  source: Object
});

// 状态管理
const isLoading = ref(false);
const hasError = ref(false);
const errorMessage = ref('');
const htmlContent = ref('');

/**
 * 🎯 计算兼容性级别
 */
const compatibilityLevel = computed(() => {
  const ext = props.source?.originalExt || 
              props.source?.file?.name?.split('.').pop()?.toLowerCase() || ''
  const compat = checkFormatCompatibility(ext)
  return compat.level
})

/**
 * 🎯 生成兼容性提示信息
 */
const compatibilityMessage = computed(() => {
  const ext = props.source?.originalExt || 
              props.source?.file?.name?.split('.').pop()?.toLowerCase() || ''
  const warning = generateUserWarning(ext)
  return warning || 'Excel 预览功能开发中'
})

/**
 * 🎯 获取文件扩展名
 */
const fileExtension = computed(() => {
  return props.source?.originalExt || 
         props.source?.file?.name?.split('.').pop()?.toLowerCase() || 'unknown'
})

/**
 * 格式化文件大小
 */
const formatFileSize = (bytes) => {
  if (!bytes) return '未知'
  if (bytes < 1024) return bytes + ' B'
  if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(2) + ' KB'
  return (bytes / (1024 * 1024)).toFixed(2) + ' MB'
}

/**
 * 🎯 转换为 PDF (调用后端服务或提示用户)
 */
const convertToPdf = () => {
  ElMessage.info('PDF 转换功能开发中，请使用 Office/WPS 另存为 PDF')
  // TODO: 集成后端转换服务
  // await invoke('convert_to_pdf', { filePath: props.source.filePath })
}

/**
 * 🎯 用外部应用打开
 */
const openInExternalApp = async () => {
  try {
    // Tauri: 使用 shell 插件打开文件
    if (window.__TAURI__) {
      const { open } = await import('@tauri-apps/plugin-shell')
      await open(props.source.filePath)
      ElMessage.success('已用默认应用打开文件')
    } else {
      ElMessage.warning('仅在 Tauri 环境中支持此功能')
    }
  } catch (error) {
    console.error('[ExcelContent] 打开文件失败:', error)
    ElMessage.error('打开文件失败')
  }
}

/**
 * 验证源是否有效
 */
const isValidSource = computed(() => {
  return (
    props.source?.type === 'excel' && 
    props.source?.file &&
    ['xls', 'xlsx', 'xlt', 'xltx', 'et', 'ett', 'ods'].includes(
      props.source.originalExt || props.source.file.name.split('.').pop().toLowerCase()
    )
  );
});

/**
 * 加载 Excel 文档
 */
const loadDocument = async () => {
  if (!isValidSource.value) return;

  isLoading.value = true;
  hasError.value = false;

  try {
    const file = props.source.file;
    const fileName = file.name.toLowerCase();
    const fileExt = (props.source.originalExt || fileName.split('.').pop()).toLowerCase();

    console.log('[ExcelContent] 加载 Excel 文档:', fileName, '扩展名:', fileExt);
    console.log('[ExcelContent] 兼容性级别:', compatibilityLevel.value);

    // 🔜 TODO: 集成 SheetJS 实现真正的 Excel 解析
    // 目前保持占位符模式,但显示更详细的兼容性信息
    
    // 不设置 htmlContent,让模板显示占位符界面
    console.log('[ExcelContent] Excel 文档加载完成（占位符模式）');
    isLoading.value = false;
  } catch (error) {
    console.error('[ExcelContent] Excel 文档加载失败:', error);
    hasError.value = true;
    errorMessage.value = error.message || 'Excel 文件解析失败';
    isLoading.value = false;
  }
};

/**
 * 重试加载
 */
const retryLoad = () => {
  hasError.value = false;
  loadDocument();
};

// 监听 source 变化
watch(() => props.source, () => {
  loadDocument();
}, { deep: true });

// 组件挂载时加载
loadDocument();
</script>

<style lang="scss" scoped>
.excel-content {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #ffffff;
  overflow: auto;
}

.loading-state,
.error-state,
.placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12px;
  padding: 40px;
  text-align: center;
  
  p {
    font-size: 16px;
    color: #606266;
    margin: 0;
  }
  
  small {
    font-size: 12px;
    color: #909399;
  }
}

.error-state {
  p {
    color: #F56C6C;
  }
}

.excel-container {
  width: 100%;
  height: 100%;
  overflow: auto;
  padding: 20px;
  
  :deep(table) {
    width: 100%;
    border-collapse: collapse;
    
    th, td {
      border: 1px solid #DCDFE6;
      padding: 8px 12px;
      text-align: left;
    }
    
    th {
      background: #F5F7FA;
      font-weight: 600;
      color: #606266;
    }
    
    tr:hover {
      background: #F5F7FA;
    }
  }
}

// 🎯 新增:占位符模式样式
.placeholder {
  .doc-title {
    font-size: 20px;
    color: #303133;
    margin: 16px 0 8px;
    font-weight: 600;
  }
  
  // 兼容性提示横幅
  .compatibility-banner {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 20px;
    border-radius: 8px;
    margin: 16px 0;
    font-size: 14px;
    
    &.level-placeholder {
      background: #FDF6EC;
      color: #E6A23C;
      border: 1px solid #F5DAB1;
    }
    
    &.level-partial {
      background: #F4F4F5;
      color: #909399;
      border: 1px solid #D3D4D6;
    }
    
    &.level-convert {
      background: #FEF0F0;
      color: #F56C6C;
      border: 1px solid #FBC4C4;
    }
  }
  
  // 功能说明
  .feature-info {
    background: #F5F7FA;
    padding: 16px 20px;
    border-radius: 8px;
    margin: 16px 0;
    text-align: left;
    width: 100%;
    max-width: 500px;
    
    h4 {
      margin: 0 0 12px;
      color: #606266;
      font-size: 14px;
    }
    
    ul {
      margin: 0;
      padding-left: 20px;
      
      li {
        margin: 8px 0;
        color: #909399;
        font-size: 13px;
        line-height: 1.6;
      }
    }
  }
  
  // 操作按钮
  .action-suggestions {
    display: flex;
    gap: 12px;
    margin: 16px 0;
  }
  
  // 文件信息
  .file-info {
    font-size: 12px;
    color: #C0C4CC;
    margin-top: 16px;
  }
}
</style>
