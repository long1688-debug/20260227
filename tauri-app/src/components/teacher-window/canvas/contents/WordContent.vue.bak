<template>
  <div class="word-content">
    <!-- Word文档容器 -->
    <div v-if="isValidSource" class="word-container">
      <!-- 文档工具栏 -->
      <div class="document-toolbar">
        <div class="document-info">
          <el-icon><Document /></el-icon>
          <span class="document-name">{{ documentName }}</span>
          <el-tag v-if="readonly" size="small" type="info">只读</el-tag>
        </div>

        <div class="document-controls">
          <el-button-group size="small">
            <el-button :disabled="currentPage <= 1" @click="previousPage">
              <el-icon><ArrowLeft /></el-icon>
            </el-button>
            <el-button disabled>{{ currentPage }} / {{ totalPages }}</el-button>
            <el-button :disabled="currentPage >= totalPages" @click="nextPage">
              <el-icon><ArrowRight /></el-icon>
            </el-button>
          </el-button-group>

          <el-select v-model="zoomLevel" size="small" style="width: 100px">
            <el-option label="50%" :value="50" />
            <el-option label="75%" :value="75" />
            <el-option label="100%" :value="100" />
            <el-option label="125%" :value="125" />
            <el-option label="150%" :value="150" />
          </el-select>
        </div>
      </div>

      <!-- 文档内容显示 -->
      <div class="document-display" :style="displayStyle">
        <!-- 🎯 使用 mammoth.js 转换后的 HTML 内容 -->
        <div 
          v-if="htmlContent" 
          class="word-html-content"
          v-html="htmlContent"
        ></div>

        <!-- 备用：图片显示 -->
        <div v-else-if="documentImages.length > 0" class="document-pages">
          <img
            :src="documentImages[currentPage - 1]"
            :alt="`第 ${currentPage} 页`"
            class="page-image"
          />
        </div>

        <!-- 占位符 -->
        <div v-else class="document-placeholder">
          <el-icon :size="64"><Document /></el-icon>
          <p>{{ documentName }}</p>
          <small>文档预览不可用</small>
          <el-button size="small" type="primary" style="margin-top: 12px" @click="downloadDocument">
            <el-icon><Download /></el-icon>
            下载文档
          </el-button>
        </div>
      </div>
    </div>

    <!-- 加载状态 -->
    <div v-else-if="isLoading" class="loading-state">
      <el-icon class="is-loading" :size="48"><Loading /></el-icon>
      <p>加载中...</p>
    </div>

    <!-- 错误状态 -->
    <div v-else-if="hasError" class="error-state">
      <el-icon :size="48"><WarningFilled /></el-icon>
      <p>文档加载失败</p>
      <small>{{ errorMessage || '请检查文件是否有效' }}</small>
      <el-button size="small" type="primary" style="margin-top: 12px" @click="retryLoad">
        重试
      </el-button>
    </div>

    <!-- 默认占位符 -->
    <div v-else class="placeholder">
      <el-icon :size="64"><Document /></el-icon>
      <p>Word文档</p>
      <small>支持 .doc, .docx 格式</small>
      <el-button size="small" type="primary" style="margin-top: 12px" @click="handleUpload">
        上传文档
      </el-button>
    </div>
  </div>
</template>

<script setup>
import { ref, computed, watch, onMounted } from 'vue';
import {
  Document, Loading, WarningFilled,
  ArrowLeft, ArrowRight, Download
} from '@element-plus/icons-vue';
import { ElMessage } from 'element-plus';
import { renderAsync } from 'docx-preview'; // 🎯 导入 docx-preview

const props = defineProps({
  source: Object
});

const emit = defineEmits(['upload-word']);

// 状态管理
const isLoading = ref(false);
const hasError = ref(false);
const errorMessage = ref('');
const currentPage = ref(1);
const totalPages = ref(1);
const zoomLevel = ref(100);
const readonly = ref(true);

// 文档相关
const documentImages = ref([]);
const htmlContent = ref(''); // 🎯 存储转换后的 HTML 内容

/**
 * 验证源是否有效
 */
const isValidSource = computed(() => {
  // 🎯 支持 Microsoft Word 和 WPS Writer 格式
  return (
    props.source?.type === 'word' && 
    props.source?.file &&
    ['doc', 'docx', 'dot', 'dotx', 'wps', 'wpt', 'odt'].includes(
      props.source.originalExt || props.source.file.name.split('.').pop().toLowerCase()
    )
  );
});

/**
 * 获取文档名称
 */
const documentName = computed(() => {
  return props.source?.name || props.source?.file?.name || '未命名文档';
});

/**
 * 获取Office Online Viewer URL
 */
const officeViewerUrl = computed(() => {
  const file = props.source?.file;
  if (!file) return null;

  // 🎯 注意：实际应用中，需要先将文件上传到服务器
  // 然后使用在线的Office Online Viewer
  // 这里我们提供一个示例URL结构

  // 使用微软Office Online Viewer
  // 格式：https://view.officeapps.live.com/op/embed.aspx?src=[URL]
  // 需要文档可以通过公网访问

  return null; // 暂时返回null，因为需要公网URL
});

/**
 * 获取显示样式
 */
const displayStyle = computed(() => {
  return {
    fontSize: `${zoomLevel.value}%`
  };
});

/**
 * 上一页
 */
const previousPage = () => {
  if (currentPage.value > 1) {
    currentPage.value--;
  }
};

/**
 * 下一页
 */
const nextPage = () => {
  if (currentPage.value < totalPages.value) {
    currentPage.value++;
  }
};

/**
 * 上传文档
 */
const handleUpload = () => {
  emit('upload-word');
};

/**
 * 重试加载
 */
const retryLoad = () => {
  hasError.value = false;
  loadDocument();
};

/**
 * 下载文档
 */
const downloadDocument = () => {
  const file = props.source?.file;
  if (file) {
    const url = URL.createObjectURL(file);
    const a = document.createElement('a');
    a.href = url;
    a.download = file.name;
    a.click();
    URL.revokeObjectURL(url);
    ElMessage.success('文档下载已开始');
  }
};

/**
 * 加载Word文档
 */
const loadDocument = async () => {
  if (!isValidSource.value) return;

  isLoading.value = true;
  hasError.value = false;
  htmlContent.value = ''; // 清空之前的内容

  try {
    const file = props.source.file;
    const fileName = file?.name || '';
    // 🎯 优先使用 source 中提供的原始扩展名，否则从文件名获取
    const fileExt = (props.source.originalExt || fileName.split('.').pop())?.toLowerCase();

    console.log('[WordContent] 加载Word文档:', fileName, '扩展名:', fileExt);

    // 🎯 使用 mammoth.js 解析 Word 文档（支持 .docx）
    if (fileExt === 'docx') {
      // 读取文件为 ArrayBuffer
      const arrayBuffer = await file.arrayBuffer();
      
      // 使用 mammoth 转换为 HTML
      const result = await mammoth.convertToHtml({ arrayBuffer });
      
      htmlContent.value = result.value;
      
      // 记录转换过程中的警告（如果有）
      if (result.messages && result.messages.length > 0) {
        console.warn('[WordContent] 转换警告:', result.messages);
      }
      
      console.log('[WordContent] DOCX 文档转换成功');
      
    // 🎯 WPS Writer 格式 (.wps, .wpt)
    } else if (['wps', 'wpt'].includes(fileExt)) {
      console.log('[WordContent] 检测到 WPS 格式文件:', fileExt);
      
      // WPS 格式需要特殊处理
      // 方案1: 尝试作为 ZIP 解压并解析（WPS 新格式基于 OOXML）
      // 方案2: 提示用户转换为 .docx
      
      // 暂时尝试用 mammoth 解析（部分 WPS 文件可能兼容）
      try {
        const arrayBuffer = await file.arrayBuffer();
        const result = await mammoth.convertToHtml({ arrayBuffer });
        
        if (result.value) {
          htmlContent.value = result.value;
          console.log('[WordContent] WPS 文档转换成功（兼容模式）');
        } else {
          throw new Error('WPS 格式不兼容，请转换为 .docx 格式');
        }
      } catch (wpsError) {
        console.warn('[WordContent] WPS 直接解析失败:', wpsError);
        throw new Error('WPS 格式需要转换为 .docx 格式才能预览。建议使用 WPS Office 或 Microsoft Word 另存为 .docx 格式。');
      }
      
    // 🎯 OpenDocument 格式 (.odt)
    } else if (fileExt === 'odt') {
      console.log('[WordContent] 检测到 OpenDocument 格式 (.odt)');
      
      // ODT 也是 ZIP 格式，可以尝试解析
      try {
        const arrayBuffer = await file.arrayBuffer();
        const result = await mammoth.convertToHtml({ arrayBuffer });
        
        if (result.value) {
          htmlContent.value = result.value;
          console.log('[WordContent] ODT 文档转换成功');
        } else {
          throw new Error('ODT 格式解析失败');
        }
      } catch (odtError) {
        console.warn('[WordContent] ODT 解析失败:', odtError);
        throw new Error('ODT 格式需要转换为 .docx 格式才能预览');
      }
      
    // 🎯 旧版 Word 格式 (.doc)
    } else if (fileExt === 'doc') {
      // .doc 格式是二进制格式，mammoth 不支持
      // 需要后端服务转换或使用其他库
      throw new Error('.doc 格式不支持直接解析，请转换为 .docx 格式。建议使用 Microsoft Word 或 WPS Office 另存为 .docx 格式。');
      
    } else {
      throw new Error('不支持的文件格式: .' + fileExt);
    }

    // 设置只读状态
    readonly.value = props.source?.properties?.readonly !== false;

    isLoading.value = false;
    console.log('[WordContent] Word文档加载成功');
  } catch (error) {
    console.error('[WordContent] Word文档加载失败:', error);
    hasError.value = true;
    errorMessage.value = error.message || '文档解析失败';
    isLoading.value = false;
  }
};

// 监听source变化
watch(() => props.source?.id, (newId, oldId) => {
  if (newId && newId !== oldId) {
    currentPage.value = 1;
    loadDocument();
  }
});

// 组件挂载时加载文档
onMounted(() => {
  if (isValidSource.value) {
    loadDocument();
  }
});
</script>

<style scoped lang="scss">
.word-content {
  width: 100%;
  height: 100%;
  background: #f0f0f0;
  display: flex;
  flex-direction: column;
  overflow: hidden;

  .word-container {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;

    .document-toolbar {
      background: white;
      padding: 8px 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid #ddd;
      flex-shrink: 0;

      .document-info {
        display: flex;
        align-items: center;
        gap: 8px;

        .document-name {
          font-size: 14px;
          font-weight: 500;
          color: #333;
        }
      }

      .document-controls {
        display: flex;
        align-items: center;
        gap: 8px;
      }
    }

    .document-display {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: auto;
      padding: 20px;
      background: #f0f0f0;

      .office-viewer {
        width: 100%;
        height: 100%;
        border: none;
      }

      // 🎯 Word HTML 内容样式
      .word-html-content {
        width: 100%;
        max-width: 800px;
        background: white;
        padding: 40px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        overflow-y: auto;
        
        // 重置默认样式
        :deep(*) {
          margin: 0;
          padding: 0;
          box-sizing: border-box;
        }
        
        // 段落样式
        :deep(p) {
          margin-bottom: 12px;
          line-height: 1.6;
          font-size: 14px;
          color: #333;
        }
        
        // 标题样式
        :deep(h1) {
          font-size: 28px;
          margin: 24px 0 16px;
          color: #222;
          font-weight: 600;
        }
        
        :deep(h2) {
          font-size: 24px;
          margin: 20px 0 12px;
          color: #222;
          font-weight: 600;
        }
        
        :deep(h3) {
          font-size: 20px;
          margin: 16px 0 10px;
          color: #333;
          font-weight: 600;
        }
        
        // 列表样式
        :deep(ul), :deep(ol) {
          margin: 12px 0;
          padding-left: 24px;
          
          li {
            margin-bottom: 6px;
            line-height: 1.6;
          }
        }
        
        // 表格样式
        :deep(table) {
          width: 100%;
          border-collapse: collapse;
          margin: 16px 0;
          
          th, td {
            border: 1px solid #ddd;
            padding: 8px 12px;
            text-align: left;
          }
          
          th {
            background-color: #f5f5f5;
            font-weight: 600;
          }
        }
        
        // 图片样式
        :deep(img) {
          max-width: 100%;
          height: auto;
          display: block;
          margin: 16px 0;
        }
        
        // 链接样式
        :deep(a) {
          color: #409eff;
          text-decoration: none;
          
          &:hover {
            text-decoration: underline;
          }
        }
        
        // 加粗和斜体
        :deep(strong), :deep(b) {
          font-weight: 600;
        }
        
        :deep(em), :deep(i) {
          font-style: italic;
        }
      }

      .document-pages {
        display: flex;
        justify-content: center;
        align-items: center;
        width: 100%;
        height: 100%;

        .page-image {
          max-width: 100%;
          max-height: 100%;
          box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
        }
      }

      .document-placeholder {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        color: #666;
        gap: 16px;
        padding: 40px;
        background: white;
        border-radius: 8px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);

        p {
          margin: 0;
          font-size: 18px;
          font-weight: 500;
        }

        small {
          font-size: 13px;
          opacity: 0.7;
        }
      }
    }
  }

  .loading-state,
  .error-state,
  .placeholder {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: #718096;
    gap: 16px;
    padding: 20px;

    p {
      margin: 0;
      font-size: 18px;
      font-weight: 500;
    }

    small {
      font-size: 13px;
      opacity: 0.7;
      text-align: center;
      max-width: 80%;
    }
  }

  .error-state {
    color: #fc8181;
  }
}
</style>
