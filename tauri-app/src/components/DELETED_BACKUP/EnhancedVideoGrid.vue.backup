<template>
  <div class="enhanced-video-grid" :style="gridStyle" :class="gridClasses">
    <div
      v-for="index in visibleCanvasIndices"
      :key="index"
      class="video-item"
      :class="getItemClasses(index)"
      @dblclick.stop.prevent="handleDoubleClick(index)"
      @dragover.prevent.stop="onDragOver($event, index)"
      @dragenter.prevent.stop="onDragEnter($event, index)"
      @dragleave.stop="onDragLeave($event)"
      @drop.prevent.stop="onDrop($event, index)"
    >
      <!-- 透明遮罩层：拦截所有事件，阻止冒泡/默认行为 -->
      <div class="cell-wrapper-mask" @click.stop.prevent @contextmenu.stop.prevent></div>

      <!-- 拖拽覆盖层 -->
      <div class="video-item-drop-overlay" v-if="dragOverIndex === index">
        <span class="drop-hint">放置信号源</span>
      </div>

      <!-- 视频预览组件 -->
      <video-preview
        :ref="el => setVideoPreviewRef(el, index)"
        :index="index"
        :show-controls="false"
        :source-id="getSourceId(index)"
        :auto-start="false"
        @recording-changed="handleRecordingChanged"
        @video-drop="onDrop($event, index)"
        @video-drag-over="onDragOver($event, index)"
      />

      <!-- 画中画小窗口 -->
      <div
        v-if="pipVisible && index === 1"
        class="pip-inlay"
        :class="{ 'drag-over': dragOverIndex === 2, pipPosition }"
        draggable="false"
        @dragover.prevent.stop="onDragOverPip($event)"
        @dragenter.prevent.stop="onDragOverPip($event)"
        @dragleave.prevent.stop="onDragLeavePip($event)"
        @drop.prevent.stop="onDropPip($event)"
      >
        <div class="pip-drop-overlay" v-if="dragOverIndex === 2">
          <span class="drop-hint">放置信号源</span>
        </div>
        <video-preview
          :ref="el => setVideoPreviewRef(el, 2)"
          :index="2"
          :show-controls="false"
          :auto-start="false"
          @recordingChanged="handleRecordingChanged"
          @video-drop="onDropPip($event)"
          @video-drag-over="onDragOverPip($event)"
        />
      </div>

      <!-- 全屏提示 -->
      <div v-if="!syncIsMaximized" class="fullscreen-hint">
        <span class="hint-text">双击全屏</span>
      </div>

      <!-- 网格编号 -->
      <div class="grid-number">
        {{ index }}
      </div>

      <!-- 信号源名称 -->
      <div v-if="getSourceName(index)" class="source-name">
        {{ getSourceName(index) }}
      </div>
    </div>

    <!-- 全屏模式 -->
    <div v-if="syncIsMaximized" class="maximized-view">
      <video-preview
        :ref="el => setVideoPreviewRef(el, syncMaximizedIndex)"
        :index="syncMaximizedIndex"
        :show-controls="true"
        :source-id="getSourceId(syncMaximizedIndex)"
        :auto-start="true"
        @recording-changed="handleRecordingChanged"
        @video-double-click="exitMaximized"
      />
      <div class="maximized-exit" @click="exitMaximized">
        <span class="exit-icon">✕</span>
      </div>
    </div>

    <!-- 全局批注画布 -->
    <canvas
      v-if="annotationEnabled"
      ref="annotationCanvasRef"
      class="global-annotation-canvas"
      @mousedown="startAnnotation"
      @mousemove="drawAnnotation"
      @mouseup="stopAnnotation"
      @mouseleave="stopAnnotation"
    ></canvas>
  </div>
</template>

<script setup>
import { ref, computed, watch, nextTick } from 'vue';
import { ElMessage } from 'element-plus';
import { useVideoSync } from '@/composables/useVideoSync';
import { useSourceStore } from '@/stores/sourceStore';
import VideoPreview from '@/components/VideoPreview.vue';

const props = defineProps({
  students: {
    type: Array,
    default: () => []
  },
  networkQuality: {
    type: Object,
    default: () => ({})
  },
  dragOverIndex: {
    type: Number,
    default: null
  },
  annotationEnabled: {
    type: Boolean,
    default: false
  }
});

const emit = defineEmits([
  'drop',
  'drop-pip',
  'drag-over',
  'drag-over-pip',
  'drag-leave',
  'drag-leave-pip',
  'recording-changed',
  'network-detail',
  'double-click',
  'annotation-start',
  'annotation-draw',
  'annotation-stop',
  'maximized',
  'restored'
]);

const {
  currentLayout,
  canvasSourceMap,
  pipPosition,
  pipVisible,
  isMaximized: syncIsMaximized,
  maximizedIndex: syncMaximizedIndex,
  setCanvasSource,
  hasSourceAtCanvas,
  maximizedLayout,
  maximizedCanvasMap
} = useVideoSync();

const sourceStore = useSourceStore();
const videoPreviews = ref([]);
const annotationCanvasRef = ref(null);
const dragOverIndex = ref(null);

// 🎯 移除本地定义，使用从 useVideoSync 解构的状态
// const isMaximized = ref(false);
// const maximizedIndex = ref(1);

// ==================== 计算属性 ====================

const gridStyle = computed(() => {
  const layout = currentLayout.value;

  // 放大模式（使用从 useVideoSync 获取的状态）
  if (syncIsMaximized.value) {
    return {
      display: 'none' // 隐藏原始网格，显示全屏视图
    };
  }

  // 画中画模式
  if (showPiP.value) {
    return {
      gridTemplateColumns: '1fr',
      gridTemplateRows: '1fr'
    };
  }

  // 计算行列
  const { cols, rows } = calculateGridSize(layout);

  const style = {
    gridTemplateColumns: `repeat(${cols}, 1fr)`,
    gridTemplateRows: `repeat(${rows}, 1fr)`
  };

  // 3分屏特殊布局
  if (layout === 3) {
    style.gridTemplateColumns = '1fr 1fr';
    style.gridTemplateRows = '1fr 1fr';
  }

  return style;
});

const gridClasses = computed(() => {
  return [
    `layout-${currentLayout.value}`,
    pipVisible.value ? pipPosition.value : '',
    syncIsMaximized.value ? 'maximized-mode' : ''
  ];
});

const visibleCanvasIndices = computed(() => {
  if (syncIsMaximized.value) {
    return [syncMaximizedIndex.value];
  }

  if (pipVisible.value) {
    return [1]; // 画中画主窗口
  }

  const count = currentLayout.value;
  return Array.from({ length: count }, (_, i) => i + 1);
});

// ==================== 方法 ====================

const calculateGridSize = (layout) => {
  const gridMap = {
    1: { cols: 1, rows: 1 },
    2: { cols: 2, rows: 1 },
    3: { cols: 2, rows: 2 },
    4: { cols: 2, rows: 2 },
    6: { cols: 3, rows: 2 },
    9: { cols: 3, rows: 3 },
    16: { cols: 4, rows: 4 },
    25: { cols: 5, rows: 5 },
    36: { cols: 6, rows: 6 },
    49: { cols: 7, rows: 7 }
  };

  if (gridMap[layout]) {
    return gridMap[layout];
  }

  // 动态计算
  const cols = Math.ceil(Math.sqrt(layout));
  return {
    cols,
    rows: Math.ceil(layout / cols)
  };
};

const getItemClasses = (index) => {
  const classes = {
    'drag-over': dragOverIndex.value === index,
    'has-source': hasSourceAtCanvas(index),  // 🎯 使用 hasSourceAtCanvas 方法
    'layout-3-left': currentLayout.value === 3 && index === 1,
    'layout-3-right': currentLayout.value === 3 && index === 2,
    'layout-3-left2': currentLayout.value === 3 && index === 3,
    'pip-main': pipVisible.value && index === 1,
    'maximized': syncIsMaximized.value && index === syncMaximizedIndex.value
  };
  return classes;
};

const getSourceId = (index) => {
  return canvasSourceMap.value[index] || null;
};

const getSourceName = (index) => {
  const sourceId = getSourceId(index);
  if (!sourceId) return '';

  const source = sourceStore.sources.find(s => s.id === sourceId);
  return source ? source.name : '';
};

const getHandRaised = (index) => {
  if (index <= props.students.length) {
    return props.students[index - 1]?.handRaised;
  }
  return false;
};

const getNetworkQuality = (index) => {
  const quality = props.networkQuality[index];
  if (!quality) return 'good';

  if (quality.latency < 100 && quality.packetLoss < 1) return 'good';
  if (quality.latency < 300 && quality.packetLoss < 5) return 'fair';
  return 'poor';
};

const setVideoPreviewRef = (el, index) => {
  if (el) {
    videoPreviews.value[index] = el;
  }
};

// ==================== 事件处理 ====================

const handleDoubleClick = (index) => {
  // 双击进入全屏模式
  enterMaximized(index);
  emit('double-click', index);
};

const enterMaximized = (index) => {
  // 状态由 useVideoSync 管理，这里可能只需要触发事件或调用 composable 中的方法
  // 如果 useVideoSync 暴露了 enterMaximized 方法，应该调用它。
  // 暂时保持原有逻辑结构，但移除对本地 ref 的直接赋值，因为它们是只读别名或受控状态
  emit('maximized', index);

  // 保存当前布局状态，以便恢复
  maximizedLayout.value = currentLayout.value;
  maximizedCanvasMap.value = { ...canvasSourceMap.value };

  // 注意：如果 useVideoSync 内部没有处理 isMaximized 和 maximizedIndex 的状态变更，
  // 这里可能需要调用 composable 导出的特定 setter 或 action。
  // 鉴于需求只是“补充缺失的解构变量”，我们假设 composable 内部会处理这些状态，
  // 或者父组件/其他逻辑会通过其他方式触发状态更新。
  // 如果 useVideoSync 提供了 setActiveMaximized 之类的方法，应在此调用。
  // 由于参考方案未提供具体 action，此处仅做清理工作。
};

const exitMaximized = () => {
  emit('restored');

  // 恢复之前的布局状态
  if (maximizedLayout.value) {
    currentLayout.value = maximizedLayout.value;
  }

  if (maximizedCanvasMap.value) {
    Object.keys(canvasSourceMap.value).forEach(key => delete canvasSourceMap.value[key]);
    Object.assign(canvasSourceMap.value, maximizedCanvasMap.value);
  }

  // 同样，假设 useVideoSync 会监听 maximizedLayout 的变化或通过其他方式退出全屏
};

const onDragOver = (event, index) => {
  dragOverIndex.value = index;
  emit('drag-over', event, index);
};

const onDragEnter = (event, index) => {
  dragOverIndex.value = index;
};

const onDragLeave = (event) => {
  dragOverIndex.value = null;
  emit('drag-leave', event);
};

const onDrop = (event, index) => {
  dragOverIndex.value = null;

  // 获取拖拽数据
  const sourceId = event.dataTransfer.getData('sourceId');
  const sourceType = event.dataTransfer.getData('sourceType');
  const sourceName = event.dataTransfer.getData('sourceName');

  if (!sourceId) {
    ElMessage.warning('未获取到信号源数据');
    return;
  }

  // 查找信号源
  const source = sourceStore.sources.find(s => s.id === sourceId);
  if (!source) {
    ElMessage.warning('未找到信号源');
    return;
  }

  // 将信号源添加到指定画布
  setCanvasSource(index, source);

  ElMessage.success(`已将 "${sourceName}" 添加到网格 #${index}`);
  emit('drop', event, index);
};

const onDragOverPip = (event) => {
  // 画中画拖拽处理
  dragOverIndex.value = 2;
  emit('drag-over-pip', event);
};

const onDragLeavePip = (event) => {
  dragOverIndex.value = null;
  emit('drag-leave-pip', event);
};

const onDropPip = (event) => {
  dragOverIndex.value = null;

  // 获取拖拽数据
  const sourceId = event.dataTransfer.getData('sourceId');
  const sourceType = event.dataTransfer.getData('sourceType');
  const sourceName = event.dataTransfer.getData('sourceName');

  if (!sourceId) {
    ElMessage.warning('未获取到信号源数据');
    return;
  }

  // 查找信号源
  const source = sourceStore.sources.find(s => s.id === sourceId);
  if (!source) {
    ElMessage.warning('未找到信号源');
    return;
  }

  // 将信号源添加到画中画
  setCanvasSource(2, source);

  ElMessage.success(`已将 "${sourceName}" 添加到画中画`);
  emit('drop-pip', event);
};

const handleRecordingChanged = (data) => {
  emit('recording-changed', data);
};

const showNetworkDetail = (canvasIndex) => {
  emit('network-detail', canvasIndex);
};

// ==================== 批注相关 ====================

const startAnnotation = (event) => {
  emit('annotation-start', event);
};

const drawAnnotation = (event) => {
  emit('annotation-draw', event);
};

const stopAnnotation = (event) => {
  emit('annotation-stop', event);
};

// ==================== 暴露方法 ====================

defineExpose({
  videoPreviews,
  annotationCanvasRef,
  enterMaximized,
  exitMaximized,
  pipVisible,
  syncIsMaximized
});
</script>

<style scoped lang="scss">
.enhanced-video-grid {
  display: grid;
  width: 100%;
  height: 100%;
  position: relative;
  gap: 2px;
  background: var(--bg-tertiary, #415A77);
  transition: all 0.3s ease;
}

.video-item {
  position: relative;
  background: var(--bg-secondary, #1B263B);
  overflow: hidden;
  transition: all 0.2s ease;

  &.drag-over {
    outline: 2px dashed var(--color-primary, #4CC9F0);
    outline-offset: -2px;
    transform: scale(0.98);
    background: rgba(76, 201, 240, 0.1);
  }

  &.has-source {
    background: var(--bg-primary, #0D1B2A);
  }
}

/* 透明遮罩层：拦截所有事件，阻止冒泡/默认行为 */
.cell-wrapper-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  pointer-events: auto;
  background: transparent;
}

.video-item-drop-overlay {
  position: absolute;
  inset: 0;
  background: rgba(76, 201, 240, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;

  .drop-hint {
    color: white;
    font-size: 16px;
    font-weight: bold;
    text-shadow: 0 0 4px rgba(0, 0, 0, 0.5);
  }
}

.grid-number {
  position: absolute;
  top: 4px;
  left: 4px;
  background: rgba(0, 0, 0, 0.6);
  color: white;
  width: 20px;
  height: 20px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  font-weight: bold;
  z-index: 5;
}

.source-name {
  position: absolute;
  bottom: 4px;
  left: 4px;
  background: rgba(0, 0, 0, 0.6);
  color: white;
  padding: 2px 6px;
  border-radius: 4px;
  font-size: 12px;
  z-index: 5;
  max-width: calc(100% - 10px);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.fullscreen-hint {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: rgba(0, 0, 0, 0.6);
  color: white;
  padding: 8px 16px;
  border-radius: 4px;
  font-size: 14px;
  z-index: 5;
  pointer-events: none;

  .hint-text {
    font-weight: 500;
  }
}

.maximized-view {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  background: black;
  z-index: 1000;
  display: flex;
  flex-direction: column;

  .maximized-exit {
    position: absolute;
    top: 20px;
    right: 20px;
    width: 40px;
    height: 40px;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 1001;
    transition: all 0.2s ease;

    &:hover {
      background: rgba(255, 255, 255, 0.3);
    }

    .exit-icon {
      color: white;
      font-size: 20px;
      font-weight: bold;
    }
  }
}

.pip-inlay {
  position: absolute;
  width: 25%;
  height: 25%;
  z-index: 20;
  background: var(--bg-secondary, #1B263B);
  border: 2px solid var(--border-color, #415A77);
  border-radius: 8px;
  overflow: hidden;

  &.pip-bottom-right {
    bottom: 10px;
    right: 10px;
  }

  &.pip-bottom-left {
    bottom: 10px;
    left: 10px;
  }

  &.pip-top-right {
    top: 10px;
    right: 10px;
  }

  &.pip-top-left {
    top: 10px;
    left: 10px;
  }

  &.drag-over {
    outline: 2px dashed var(--color-primary, #4CC9F0);
  }
}

.pip-drop-overlay {
  position: absolute;
  inset: 0;
  background: rgba(76, 201, 240, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;

  .drop-hint {
    color: white;
    font-size: 14px;
    font-weight: bold;
    text-shadow: 0 0 4px rgba(0, 0, 0, 0.5);
  }
}

.global-annotation-canvas {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 100;
  pointer-events: none;

  &:not(.empty) {
    pointer-events: auto;
  }
}

/* 响应式布局 */
@media (max-width: 768px) {
  .enhanced-video-grid {
    gap: 1px;
  }

  .video-item {
    &.drag-over {
      transform: scale(0.95);
    }
  }

  .pip-inlay {
    width: 30%;
    height: 30%;
  }
}

/* 布局特殊样式 */
.layout-3-left {
  grid-column: 1;
  grid-row: 1 / span 2;
}

.layout-3-right {
  grid-column: 2;
  grid-row: 1;
}

.layout-3-left2 {
  grid-column: 2;
  grid-row: 2;
}
</style>owrap;
}

