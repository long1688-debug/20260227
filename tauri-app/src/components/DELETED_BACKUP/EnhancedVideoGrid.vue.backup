  &.pip-bottom-right {
    bottom: 10px;
    right: 10px;
  }

  &.pip-bottom-left {
    bottom: 10px;
    left: 10px;
  }

  &.pip-top-right {
    top: 10px;
    right: 10px;
  }

  &.pip-top-left {
    top: 10px;
    left: 10px;
  }

  &.drag-over {
    outline: 2px dashed var(--color-primary, #4CC9F0);
  }
}

.pip-drop-overlay {
  position: absolute;
  inset: 0;
  background: rgba(76, 201, 240, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;

  .drop-hint {
    color: white;
    font-size: 14px;
    font-weight: bold;
    text-shadow: 0 0 4px rgba(0, 0, 0, 0.5);
  }
}

.global-annotation-canvas {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 50;
  pointer-events: none;
}
