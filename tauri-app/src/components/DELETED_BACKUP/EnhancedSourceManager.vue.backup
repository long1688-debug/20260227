<template>
  <div class="enhanced-source-manager">
    <!-- 信号源管理头部 -->
    <div class="source-manager-header">
      <div class="header-title">
        <h3>信号源管理</h3>
        <span class="source-count">({{ allSources.length }})</span>
      </div>
      <div class="header-actions">
        <el-button type="primary" size="small" @click="showAddSourceDialog = true">
          <el-icon><Plus /></el-icon> 添加信号源
        </el-button>
        <el-button type="info" size="small" @click="refreshSources">
          <el-icon><Refresh /></el-icon> 刷新
        </el-button>
      </div>
    </div>

    <!-- 信号源分类标签 -->
    <div class="source-categories">
      <el-tabs v-model="activeCategory" @tab-click="handleCategoryChange">
        <el-tab-pane 
          v-for="category in sourceCategories" 
          :key="category.key" 
          :label="category.name" 
          :name="category.key"
        >
          <div class="source-list">
            <!-- 信号源列表 -->
            <div 
              v-for="source in filteredSources" 
              :key="source.id" 
              class="source-item"
              :class="{ 
                'added-to-preview': source.addedToPreview,
                'dragging': isDraggingSource === source.id 
              }"
              @mousedown="handleMouseDown($event, source)"
              @touchstart="handleTouchStart($event, source)"
            >
              <!-- 信号源信息 -->
              <div class="source-info">
                <div class="source-icon">{{ getSourceTypeIcon(source.type) }}</div>
                <div class="source-details">
                  <div class="source-name">{{ source.name }}</div>
                  <div class="source-meta">
                    <el-tag :type="getSourceTypeTag(source.type)" size="small">
                      {{ getSourceTypeLabel(source.type) }}
                    </el-tag>
                    <span class="source-status" :class="{ online: source.status === 'online' }">
                      {{ source.status === 'online' ? '在线' : '离线' }}
                    </span>
                  </div>
                </div>
              </div>

              <!-- 快速操作按钮 -->
              <div class="source-actions">
                <el-tooltip 
                  :content="source.addedToPreview ? '从预览移除' : '添加到预览'" 
                  placement="top"
                >
                  <el-button 
                    :type="source.addedToPreview ? 'warning' : 'primary'" 
                    size="small"
                    @click="togglePreview(source)"
                  >
                    {{ source.addedToPreview ? '移除' : '添加' }}
                  </el-button>
                </el-tooltip>

                <el-tooltip content="重命名" placement="top">
                  <el-button size="small" @click="renameSource(source)">
                    <el-icon><Edit /></el-icon>
                  </el-button>
                </el-tooltip>

                <el-tooltip 
                  :content="source.addedToPreview ? '请先从预览移除后再删除' : '删除'" 
                  placement="top"
                >
                  <el-button 
                    type="danger" 
                    size="small"
                    :disabled="source.addedToPreview"
                    @click="deleteSource(source.id)"
                  >
                    <el-icon><Delete /></el-icon>
                  </el-button>
                </el-tooltip>
              </div>
            </div>

            <!-- 空状态 -->
            <div v-if="filteredSources.length === 0" class="empty-state">
              <el-empty description="暂无信号源">
                <el-button type="primary" @click="showAddSourceDialog = true">添加信号源</el-button>
              </el-empty>
            </div>
          </div>
        </el-tab-pane>
      </el-tabs>
    </div>

    <!-- 添加信号源对话框 -->
    <el-dialog 
      v-model="showAddSourceDialog" 
      title="添加信号源" 
      width="600px"
      :before-close="handleDialogClose"
    >
      <div class="add-source-form">
        <!-- 信号源类型选择 -->
        <div class="source-type-selection">
          <el-radio-group v-model="selectedSourceType" @change="handleSourceTypeChange">
            <el-radio-button 
              v-for="type in SOURCE_TYPE_OPTIONS" 
              :key="type.value" 
              :label="type.value"
            >