<template>
  <div class="side-panel">
    <div class="tabs">
      <button 
        v-for="tab in tabs" 
        :key="tab.name"
        :class="['tab-btn', { active: activeTab === tab.name }]"
        @click="activeTab = tab.name"
      >
        {{ tab.label }}
      </button>
    </div>
    
    <div class="tab-divider"></div>
    
    <div class="tab-content">
      <WebPanel v-show="activeTab === 'web'" />
      <StudentsPanel v-show="activeTab === 'students'" />
      <PtzPanel v-show="activeTab === 'ptz'" />
    </div>
  </div>
</template>

<script setup>
import { ref } from 'vue';
import WebPanel from './panels/WebPanel.vue';
import StudentsPanel from './panels/StudentsPanel.vue';
import PtzPanel from './panels/PtzPanel.vue';

const activeTab = ref('web');

const tabs = [
  { name: 'web', label: 'Web 功能' },
  { name: 'students', label: '学生' },
  { name: 'ptz', label: '云台控制' }
];
</script>

