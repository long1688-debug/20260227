<template>
  <div class="video-grid" :style="gridStyle" :class="gridClasses">
    <VideoItem
      v-for="index in visibleCanvasIndices"
      :key="index"
      :index="index"
      :is-maximized="isMaximized"
      :maximized-index="maximizedIndex"
      :drag-over-index="dragOverIndex"
      :source-id="getSourceId(index)"
      :video-source="getVideoSource(getSourceId(index))"
      :is-hand-raised="getHandRaised(index)"
      :network-quality="getNetworkQuality(index)"
      :item-classes="getItemClasses(index)"
      @double-click="handleDoubleClick"
      @drag-over="onDragOver"
      @drag-enter="onDragOver"
      @drag-leave="onDragLeave"
      @drop="onDrop"
      @recording-changed="handleRecordingChanged"
      @show-network-detail="showNetworkDetail"
      @set-video-preview-ref="setVideoPreviewRef"
    />

    <!-- 画中画小窗口 -->
    <PictureInPicture
      :visible="showPiP && hasMainCanvas"
      :position="pipPosition"
      :drag-over-index="dragOverIndex"
      :index="2"
      @drag-over="onDragOverPip"
      @drag-enter="onDragOverPip"
      @drag-leave="onDragLeavePip"
      @drop="onDropPip"
      @recording-changed="handleRecordingChanged"
      @close="handleClosePip"
      @set-video-preview-ref="setVideoPreviewRef"
    />
    </div>

    <!-- 全局批注画布 -->
    <canvas
      v-if="annotationEnabled"
      ref="annotationCanvasRef"
      class="global-annotation-canvas"
      @mousedown="startAnnotation"
      @mousemove="drawAnnotation"
      @mouseup="stopAnnotation"
      @mouseleave="stopAnnotation"
    ></canvas>
  </div>
</template>

<script setup>
import { ref, computed, watch, nextTick } from 'vue';
import { useVideoSyncAdapter } from '@/composables/useVideoSyncAdapter';
import VideoPreview from '@/components/VideoPreview.vue';
import VideoItem from '@/components/teacher-window/video/VideoItem.vue';
import PictureInPicture from '@/components/teacher-window/video/PictureInPicture.vue';

const props = defineProps({
  students: {
    type: Array,
    default: () => []
  },
  networkQuality: {
    type: Object,
    default: () => ({})
  },
  dragOverIndex: {
    type: Number,
    default: null
  },
  annotationEnabled: {
    type: Boolean,
    default: false
  }
});

const emit = defineEmits([
  'drop',
  'drop-pip',
  'drag-over',
  'drag-over-pip',
  'drag-leave',
  'drag-leave-pip',
  'recording-changed',
  'network-detail',
  'double-click',
  'annotation-start',
  'annotation-draw',
  'annotation-stop'
]);

const {
  currentLayout,
  isMaximized,
  maximizedIndex,
  pipVisible,
  pipPosition,
  canvasSourceMap,
  hasSourceAtCanvas,
  getSyncStatus,
  videoPreviews, // 🎯 关键修复：从 useVideoSyncAdapter 解构 videoPreviews
  initVideoPreviewsLength, // 🎯 关键修复：导入初始化方法
  getVisibleCanvasCount, // 🎯 关键修复：导入获取可见画布数量的方法
  allSources // 🎯 布局切换修复：解构 allSources 用于获取视频源
} = useVideoSyncAdapter();

// 🎯 删除本地定义的 videoPreviews，使用 useVideoSync 中的
// const videoPreviews = ref([]);

const annotationCanvasRef = ref(null);

// ==================== 辅助函数 ====================

/**
 * 🎯 布局切换修复：根据 sourceId 获取对应的视频源对象
 */
const getVideoSource = (sourceId) => {
  if (!sourceId) {
    console.log(`[VideoGrid.getVideoSource] sourceId为空，返回null`);
    return null;
  }
  const source = allSources.value.find(s => s.id === sourceId);
  console.log(`[VideoGrid.getVideoSource] sourceId=${sourceId}, 找到信号源:`, source ? source.name : 'null');
  return source || null;
};

// ==================== 监听布局变化，更新 videoPreviews 长度 ====================
watch(currentLayout, (newLayout) => {
  console.log(`[VideoGrid] 布局变化: ${newLayout}, 初始化 videoPreviews 长度`);

  // 根据布局初始化 videoPreviews 数组长度
  const visibleCount = getVisibleCanvasCount(newLayout);

  // 🎯 关键修复：确保videoPreviews数组长度足够
  if (videoPreviews.value.length < visibleCount) {
    while (videoPreviews.value.length < visibleCount) {
      videoPreviews.value.push(null);
    }
    console.log(`[VideoGrid] 扩展 videoPreviews 数组长度到: ${visibleCount}`);
  }

  // 🎯 关键修复：调用initVideoPreviewsLength确保useVideoSync中的数组也被更新
  if (typeof initVideoPreviewsLength === 'function') {
    initVideoPreviewsLength(visibleCount);
  }
}, { immediate: true });

// ==================== 计算属性 ====================

const gridStyle = computed(() => {
  const layout = currentLayout.value;

  // 放大模式
  if (isMaximized.value) {
    return {
      gridTemplateColumns: '1fr',
      gridTemplateRows: '1fr'
    };
  }

  // 画中画模式
  if (pipVisible.value) {
    return {
      gridTemplateColumns: '1fr',
      gridTemplateRows: '1fr'
    };
  }

  // 计算行列
  const { cols, rows } = calculateGridSize(layout);

  const style = {
    gridTemplateColumns: `repeat(${cols}, 1fr)`,
    gridTemplateRows: `repeat(${rows}, 1fr)`
  };

  // 3分屏特殊布局
  if (layout === 3) {
    style.gridTemplateColumns = '1fr 1fr';
    style.gridTemplateRows = '1fr 1fr';
  }

  return style;
});

const gridClasses = computed(() => {
  return [
    `layout-${currentLayout.value}`,
    pipVisible.value ? pipPosition.value : '',
    isMaximized.value ? 'maximized-mode' : ''
  ];
});

const visibleCanvasIndices = computed(() => {
  if (isMaximized.value) {
    return [maximizedIndex.value];
  }

  if (pipVisible.value) {
    return [1]; // 画中画主窗口
  }

  const count = currentLayout.value;
  return Array.from({ length: count }, (_, i) => i + 1);
});

// ==================== 方法 ====================

const calculateGridSize = (layout) => {
  const gridMap = {
    1: { cols: 1, rows: 1 },
    2: { cols: 2, rows: 1 },
    3: { cols: 2, rows: 2 },
    4: { cols: 2, rows: 2 },
    6: { cols: 3, rows: 2 },
    9: { cols: 3, rows: 3 },
    16: { cols: 4, rows: 4 },
    25: { cols: 5, rows: 5 },
    36: { cols: 6, rows: 6 },
    49: { cols: 7, rows: 7 }
  };

  if (gridMap[layout]) {
    return gridMap[layout];
  }

  // 动态计算
  const cols = Math.ceil(Math.sqrt(layout));
  return {
    cols,
    rows: Math.ceil(layout / cols)
  };
};

const getItemClasses = (index) => {
  const classes = {
    'drag-over': props.dragOverIndex === index,
    'has-source': hasSourceAtCanvas(index),
    'layout-3-left': currentLayout.value === 3 && index === 1,
    'layout-3-right': currentLayout.value === 3 && index === 2,
    'layout-3-left2': currentLayout.value === 3 && index === 3,
    'pip-main': pipVisible.value && index === 1,
    'maximized': isMaximized.value && index === maximizedIndex.value
  };
  return classes;
};

const getSourceId = (index) => {
  return canvasSourceMap.value[index] || null;
};

const getHandRaised = (index) => {
  if (index <= props.students.length) {
    return props.students[index - 1]?.handRaised;
  }
  return false;
};

const getNetworkQuality = (index) => {
  const quality = props.networkQuality[index];
  if (!quality) return 'good';

  if (quality.latency < 100 && quality.packetLoss < 1) return 'good';
  if (quality.latency < 300 && quality.packetLoss < 5) return 'fair';
  return 'poor';
};

const setVideoPreviewRef = (el, index) => {
  if (el) {
    // 🎯 关键修复：确保videoPreviews数组索引与画布索引对应
    // 画布索引从1开始，数组索引从0开始
    const arrayIndex = index - 1;

    // 如果数组长度不足，先扩展数组
    while (videoPreviews.value.length <= arrayIndex) {
      videoPreviews.value.push(null);
    }

    // 设置引用
    videoPreviews.value[arrayIndex] = el;

    console.log(`[VideoGrid.setVideoPreviewRef] 设置引用: index=${index}, arrayIndex=${arrayIndex}, sourceId=${getSourceId(index)}`);
  }
};

// ==================== 事件处理 ====================

const handleDoubleClick = (index) => {
  emit('double-click', index);
};

const onDragOver = (event, index) => {
  emit('drag-over', event, index);
};

const onDragLeave = (event) => {
  emit('drag-leave', event);
};

const onDrop = (event, index) => {
  emit('drop', event, index);
};

const onDragOverPip = (event) => {
  emit('drag-over-pip', event);
};

const onDragLeavePip = (event) => {
  emit('drag-leave-pip', event);
};

const onDropPip = (event) => {
  emit('drop-pip', event);
};

const handleClosePip = () => {
  emit('close-pip');
};

const handleRecordingChanged = (data) => {
  emit('recording-changed', data);
};

const handleSyncUpdate = (data) => {
  emit('sync-update', data);
};

const showNetworkDetail = (canvasIndex) => {
  emit('network-detail', canvasIndex);
};

// ==================== 批注相关 ====================

const startAnnotation = (event) => {
  emit('annotation-start', event);
};

const drawAnnotation = (event) => {
  emit('annotation-draw', event);
};

const stopAnnotation = (event) => {
  emit('annotation-stop', event);
};

// ==================== 暴露方法 ====================

defineExpose({
  videoPreviews,
  annotationCanvasRef
});
</script>

<style scoped lang="scss">
.video-grid {
  display: grid;
  width: 100%;
  height: 100%;
  position: relative;
  gap: 2px;
  background: var(--bg-tertiary, #415A77);
}

.video-item {
  position: relative;
  background: var(--bg-secondary, #1B263B);
  overflow: hidden;
  transition: all 0.2s ease;

  &.drag-over {
    outline: 2px dashed var(--color-primary, #4CC9F0);
    outline-offset: -2px;
    transform: scale(0.98);
  }

  &.has-source {
    background: var(--bg-primary, #0D1B2A);
  }
}

/* 透明遮罩层：拦截所有事件，阻止冒泡/默认行为 */
.cell-wrapper-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  pointer-events: auto;
  background: transparent;

  /* 在放大模式下允许内部交互 */
  &.allow-interaction {
    pointer-events: none;
  }
}

.video-item-drop-overlay {
  position: absolute;
  inset: 0;
  background: rgba(76, 201, 240, 0.1);
  z-index: 10;
  pointer-events: none;
}

.pip-inlay {
  position: absolute;
  width: 25%;
  height: 25%;
  z-index: 20;
  background: var(--bg-secondary, #1B263B);
  border: 2px solid var(--border-color, #415A77);
  border-radius: 8px;
  overflow: hidden;

  &.pip-bottom-right {
    bottom: 10px;
    right: 10px;
  }

  &.pip-bottom-left {
    bottom: 10px;
    left: 10px;
  }

  &.pip-top-right {
    top: 10px;
    right: 10px;
  }

  &.pip-top-left {
    top: 10px;
    left: 10px;
  }

  &.drag-over {
    outline: 2px dashed var(--color-primary, #4CC9F0);
  }
}

.pip-drop-overlay {
  position: absolute;
  inset: 0;
  background: rgba(76, 201, 240, 0.1);
  z-index: 10;
  pointer-events: none;
}

.hand-badge {
  position: absolute;
  top: 10px;
  right: 10px;
  background: var(--color-warning, #FFD166);
  color: var(--text-primary, #E0E1DD);
  padding: 4px 8px;
  border-radius: 12px;
  font-size: 12px;
  z-index: 15;
}

.network-quality-indicator {
  position: absolute;
  bottom: 10px;
  left: 10px;
  display: flex;
  gap: 4px;
  cursor: pointer;
  z-index: 15;

  .quality-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--text-muted, #6C757D);

    &.good {
      background: var(--color-success, #06D6A0);
    }

    &.fair {
      background: var(--color-warning, #FFD166);
    }

    &.poor {
      background: var(--color-danger, #EF476F);
    }
  }
}

.audio-route-indicator {
  position: absolute;
  bottom: 10px;
  right: 10px;
  cursor: pointer;
  z-index: 15;
  background: rgba(0, 0, 0, 0.6);
  border-radius: 50%;
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s;

  &:hover {
    background: rgba(0, 0, 0, 0.8);
    transform: scale(1.1);
  }

  .audio-icon {
    font-size: 18px;
    opacity: 0.5;
    transition: opacity 0.2s;

    &.active {
      opacity: 1;
    }
  }
}

.global-annotation-canvas {
  position: absolute;
  inset: 0;
  z-index: 50;
  cursor: crosshair;
}
</style>
