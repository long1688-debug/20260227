<template>
  <div class="enhanced-teacher-window">
    <!-- 主工具栏 -->
    <div class="main-toolbar">
      <div class="toolbar-left">
        <h2>教学控制台</h2>
        <el-select v-model="currentLayout" @change="handleLayoutChange" size="small" style="width: 100px">
          <el-option label="1分屏" :value="1" />
          <el-option label="2分屏" :value="2" />
          <el-option label="3分屏" :value="3" />
          <el-option label="4分屏" :value="4" />
          <el-option label="6分屏" :value="6" />
          <el-option label="9分屏" :value="9" />
          <el-option label="16分屏" :value="16" />
        </el-select>
      </div>

      <div class="toolbar-center">
        <el-button-group>
          <el-button type="primary" size="small" @click="toggleAnnotation">
            <el-icon><Edit /></el-icon> 批注
          </el-button>
          <el-button type="primary" size="small" @click="toggleRecording">
            <el-icon><VideoCamera /></el-icon> 录制
          </el-button>
        </el-button-group>
      </div>

      <div class="toolbar-right">
        <el-button type="info" size="small" @click="togglePiP">
          <el-icon><FullScreen /></el-icon> 画中画
        </el-button>
        <el-button type="info" size="small" @click="showSourceManager = true">
          <el-icon><Plus /></el-icon> 信号源
        </el-button>
      </div>
    </div>

    <!-- 主内容区 -->
    <div class="main-content">
      <!-- 视频网格区域 -->
      <div class="video-grid-container">
        <enhanced-video-grid
          :students="students"
          :network-quality="networkQuality"
          :drag-over-index="dragOverIndex"
          :annotation-enabled="annotationEnabled"
          @drop="handleVideoDrop"
          @drag-over="handleVideoDragOver"
          @drag-leave="handleVideoDragLeave"
          @double-click="handleDoubleClick"
          @maximized="handleMaximized"
          @restored="handleRestored"
        />
      </div>

      <!-- 预览区域 -->
      <div class="preview-container">
        <div class="preview-header">
          <h3>信号源预览</h3>
          <div class="preview-actions">
            <el-button type="primary" size="small" @click="showSourceManager = true">
              <el-icon><Plus /></el-icon> 添加信号源
            </el-button>
          </div>
        </div>

        <div class="preview-content">
          <source-manager
            :all-sources="allSources"
            @add-to-preview="handleAddToPreview"
            @remove-from-preview="handleRemoveFromPreview"
            @rename="handleRenameSource"
            @delete="handleDeleteSource"
          />
        </div>
      </div>
    </div>

    <!-- 信号源管理对话框 -->
    <el-dialog 
      v-model="showSourceManager" 
      title="信号源管理" 
      width="80%"
      :before-close="handleSourceManagerClose"
    >
      <div class="source-manager-dialog-content">
        <enhanced-source-manager />
      </div>
    </el-dialog>

    <!-- 批注工具栏 -->
    <div v-if="annotationEnabled" class="annotation-toolbar">
      <div class="annotation-tools">
        <el-button-group>
          <el-button size="small" @click="setAnnotationTool('pen')">
            <el-icon><Edit /></el-icon> 画笔
          </el-button>
          <el-button size="small" @click="setAnnotationTool('eraser')">
            <el-icon><Brush /></el-icon> 橡皮擦
          </el-button>
          <el-button size="small" @click="setAnnotationTool('text')">
            <el-icon><Key /></el-icon> 文字
          </el-button>
          <el-button size="small" @click="setAnnotationTool('shape')">
            <el-icon><Operation /></el-icon> 形状
          </el-button>
        </el-button-group>

        <el-color-picker v-model="annotationColor" size="small" />

        <el-button type="danger" size="small" @click="clearAnnotation">
          <el-icon><Delete /></el-icon> 清除
        </el-button>
      </div>
    </div>
  </div>
</template>

<script setup>
import { ref, computed, onMounted, nextTick } from 'vue';
import { ElMessage, ElMessageBox } from 'element-plus';
import { Edit, VideoCamera, FullScreen, Plus, Brush, Key, Operation, Delete } from '@element-plus/icons-vue';
import { useVideoSync } from '@/composables/useVideoSync';
import { useSourceStore } from '@/stores/sourceStore';
import EnhancedVideoGrid from './EnhancedVideoGrid.vue';
import EnhancedSourceManager from './EnhancedSourceManager.vue';
import SourceManager from './SourceManager.vue';

const {
  // 布局管理
  currentLayout,
  setLayout,
  togglePip,
  maximizeCanvas,
  restoreLayout,
  // 信号源管理
  allSources: videoAllSources,
  setCanvasSource,
  removeSource,
  updateSource,
  hasSourceAtCanvas,
  canvasSourceMap,
  isMaximized,
  maximizedIndex
} = useVideoSync();

const sourceStore = useSourceStore();

// 状态定义
const showSourceManager = ref(false);
const annotationEnabled = ref(false);
const annotationTool = ref('pen');
const annotationColor = ref('#4CC9F0');
const dragOverIndex = ref(null);

// 模拟学生数据
const students = ref([
  { id: 1, name: '学生1', handRaised: false },
  { id: 2, name: '学生2', handRaised: false },
  { id: 3, name: '学生3', handRaised: false },
  { id: 4, name: '学生4', handRaised: false }
]);

// 模拟网络质量数据
const networkQuality = ref({
  1: { latency: 80, packetLoss: 0.5 },
  2: { latency: 120, packetLoss: 1.2 },
  3: { latency: 95, packetLoss: 0.8 },
  4: { latency: 110, packetLoss: 1.5 }
});

// 计算属性
const allSources = computed(() => {
  return sourceStore.sources;
});

// 方法
const handleLayoutChange = (layout) => {
  setLayout(layout);
  ElMessage.success(`已切换到${layout}分屏布局`);
};

const toggleAnnotation = () => {
  annotationEnabled.value = !annotationEnabled.value;
  ElMessage.success(annotationEnabled.value ? '已启用批注功能' : '已关闭批注功能');
};

const toggleRecording = () => {
  // 实现录制逻辑
  ElMessage.success('录制功能已启动');
};

const togglePiP = () => {
  togglePip();
  ElMessage.success('已切换画中画模式');
};

const handleSourceManagerClose = () => {
  showSourceManager.value = false;
};

const handleVideoDrop = (event, index) => {
  // 处理视频网格中的拖放
  const sourceId = event.dataTransfer.getData('sourceId');
  if (!sourceId) return;

  const source = sourceStore.sources.find(s => s.id === sourceId);
  if (!source) return;

  setCanvasSource(index, source);
  ElMessage.success(`已将信号源添加到网格 ${index}`);
};

const handleVideoDragOver = (event, index) => {
  dragOverIndex.value = index;
};

const handleVideoDragLeave = (event) => {
  dragOverIndex.value = null;
};

const handleDoubleClick = (index) => {
  // 处理双击事件
  console.log(`双击网格 ${index}`);
};

const handleMaximized = (index) => {
  maximizeCanvas(index);
  console.log(`全屏显示网格 ${index}`);
};

const handleRestored = () => {
  restoreLayout();
  console.log('已退出全屏模式');
};

const handleAddToPreview = (source) => {
  // 添加到预览
  const emptyCanvasIndex = findEmptyCanvasIndex();
  if (emptyCanvasIndex !== -1) {
    setCanvasSource(emptyCanvasIndex, source);
    source.addedToPreview = true;
    ElMessage.success(`已将 "${source.name}" 添加到预览窗口 #${emptyCanvasIndex}`);
  } else {
    ElMessage.warning('当前所有预览窗口都已占用，请先移除一些信号源');
  }
};

const handleRemoveFromPreview = (sourceId) => {
  // 从预览移除
  Object.keys(canvasSourceMap).forEach(canvasIndex => {
    if (canvasSourceMap[canvasIndex] === sourceId) {
      setCanvasSource(parseInt(canvasIndex), null);
    }
  });

  const source = sourceStore.sources.find(s => s.id === sourceId);
  if (source) {
    source.addedToPreview = false;
  }

  ElMessage.success('已从预览窗口移除信号源');
};

const handleRenameSource = (source) => {
  // 重命名信号源
  ElMessageBox.prompt('请输入新的信号源名称', '重命名信号源', {
    confirmButtonText: '确定',
    cancelButtonText: '取消',
    inputValue: source.name
  }).then(({ value }) => {
    if (value && value !== source.name) {
      updateSource(source.id, { name: value });
      ElMessage.success('重命名成功');
    }
  }).catch(() => {});
};

const handleDeleteSource = (sourceId) => {
  // 删除信号源
  const source = sourceStore.sources.find(s => s.id === sourceId);
  if (!source) return;

  ElMessageBox.confirm(
    `确定删除信号源 "${source.name}" 吗？

此操作不可恢复！`,
    '删除信号源',
    {
      confirmButtonText: '确定',
      cancelButtonText: '取消',
      type: 'error'
    }
  ).then(() => {
    removeSource(sourceId);
    ElMessage.success('已删除信号源');
  }).catch(() => {});
};

const findEmptyCanvasIndex = () => {
  // 查找第一个空画布索引
  // 注意：currentLayout 现在是 ref 对象，需要 .value
  const maxCanvasIndex = currentLayout.value;

  for (let i = 1; i <= maxCanvasIndex; i++) {
    if (!hasSourceAtCanvas(i)) {
      return i;
    }
  }

  return -1; // 所有画布都已占用
};

const setAnnotationTool = (tool) => {
  annotationTool.value = tool;
  ElMessage.success(`已切换到${tool === 'pen' ? '画笔' : tool === 'eraser' ? '橡皮擦' : tool === 'text' ? '文字' : '形状'}工具`);
};

const clearAnnotation = () => {
  // 清除批注
  ElMessage.success('已清除所有批注');
};

// 初始化
onMounted(() => {
  // 初始化一些示例信号源
  const sampleSources = [
    {
      id: 'camera-1',
      name: '教室摄像头',
      type: 'localCamera',
      status: 'online',
      addedToPreview: false
    },
    {
      id: 'video-1',
      name: '教学视频.mp4',
      type: 'localVideo',
      status: 'online',
      addedToPreview: false
    },
    {
      id: 'screen-1',
      name: '教师屏幕',
      type: 'remoteDesktop',
      status: 'online',
      addedToPreview: false
    }
  ];

  sampleSources.forEach(source => {
    sourceStore.addSource(source);
  });
});
</script>

<style scoped lang="scss">
.enhanced-teacher-window {
  display: flex;
  flex-direction: column;
  height: 100%;
  background: var(--bg-color-page, #f5f7fa);
  border-radius: 8px;
  overflow: hidden;
}

.main-toolbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12px 16px;
  background: var(--bg-color-component, #fff);
  border-bottom: 1px solid var(--border-color-light, #e4e7ed);

  .toolbar-left {
    display: flex;
    align-items: center;
    gap: 16px;

    h2 {
      margin: 0;
      font-size: 16px;
      font-weight: 600;
      color: var(--text-primary, #303133);
    }
  }

  .toolbar-center {
    display: flex;
    gap: 8px;
  }

  .toolbar-right {
    display: flex;
    gap: 8px;
  }
}

.main-content {
  display: flex;
  flex: 1;
  overflow: hidden;
}

.video-grid-container {
  flex: 1;
  overflow: hidden;
  position: relative;
  background: var(--bg-color-secondary, #f0f2f5);
}

.preview-container {
  width: 320px;
  background: var(--bg-color-component, #fff);
  border-left: 1px solid var(--border-color-light, #e4e7ed);
  display: flex;
  flex-direction: column;

  .preview-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border-color-light, #e4e7ed);

    h3 {
      margin: 0;
      font-size: 14px;
      font-weight: 500;
      color: var(--text-primary, #303133);
    }

    .preview-actions {
      display: flex;
      gap: 8px;
    }
  }

  .preview-content {
    flex: 1;
    overflow-y: auto;
    padding: 12px;
  }
}

.source-manager-dialog-content {
  height: 500px;
  overflow: hidden;
}

.annotation-toolbar {
  position: absolute;
  bottom: 20px;
  left: 50%;
  transform: translateX(-50%);
  background: rgba(0, 0, 0, 0.7);
  border-radius: 8px;
  padding: 8px;
  display: flex;
  align-items: center;
  gap: 12px;
  z-index: 1000;

  .annotation-tools {
    display: flex;
    align-items: center;
    gap: 12px;
  }
}

/* 响应式布局 */
@media (max-width: 1200px) {
  .preview-container {
    width: 280px;
  }
}

@media (max-width: 768px) {
  .main-content {
    flex-direction: column;
  }

  .preview-container {
    width: 100%;
    height: 200px;
    border-left: none;
    border-top: 1px solid var(--border-color-light, #e4e7ed);
  }
}
</style>