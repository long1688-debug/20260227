<template>
  <div class="video-section">
    <div class="video-header">
      <label>布局:</label>
      <el-select v-model="currentLayout" placeholder="选择布局" class="layout-select">
        <el-option label="1 分屏" :value="1" />
        <el-option label="2 分屏" :value="2" />
        <el-option label="3 分屏" :value="3" />
        <el-option label="4 分屏" :value="4" />
        <el-option label="6 分屏" :value="6" />
        <el-option label="9 分屏" :value="9" />
        <el-option label="16 分屏" :value="16" />
        <el-option label="25 分屏" :value="25" />
        <el-option label="36 分屏" :value="36" />
      </el-select>
    </div>
    
    <div class="video-grid" :style="gridStyle">
      <div 
        v-for="index in currentLayout" 
        :key="index"
        class="video-area"
        @dblclick="handleDoubleClick(index)"
      >
        <div class="video-content">
          <span class="camera-name">摄像头 {{ index }}</span>
        </div>
        <div class="video-status">
          <div class="status-dot"></div>
        </div>
      </div>
    </div>
  </div>
</template>

<script setup>
import { ref, computed } from 'vue';

const currentLayout = ref(1);

const gridStyle = computed(() => {
  const cols = Math.ceil(Math.sqrt(currentLayout.value));
  return {
    gridTemplateColumns: `repeat(${cols}, 1fr)`
  };
});

const handleDoubleClick = (index) => {
  console.log('Double click on video:', index);
  // 实现全屏逻辑
};
</script>

