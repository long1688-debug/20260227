<template>
  <div class="menu-bar">
    <button 
      v-for="menu in menus" 
      :key="menu.name"
      :class="['menu-item', { active: activeMenu === menu.name, 'web-feature': menu.isWeb }]"
      @click="selectMenu(menu.name)"
    >
      <span v-if="menu.icon" class="menu-icon">{{ menu.icon }}</span>
      {{ menu.label }}
    </button>
  </div>
</template>

<script setup>
import { ref } from 'vue';

const activeMenu = ref('layout');

const menus = [
  { name: 'layout', label: '布局' },
  { name: 'students', label: '学生' },
  { name: 'tasks', label: '任务' },
  { name: 'stream', label: '流媒体' },
  { name: 'camera', label: '摄像头' },
  { name: 'settings', label: '设置' },
  { name: 'web', label: '🌐 Web 功能', isWeb: true }
];

const selectMenu = (name) => {
  activeMenu.value = name;
  console.log('Selected menu:', name);
};
</script>

<style lang="scss" scoped>
.menu-bar {
  height: 60px;
  background: #0F2035;
  display: flex;
  align-items: center;
  padding: 0 10px;
}

.menu-item {
  height: 50px;
  padding: 0 20px;
  border: none;
  background: transparent;
  color: #FFFFFF;
  font-size: 14px;
  cursor: pointer;
  transition: all 0.2s;
  display: flex;
  align-items: center;
  gap: 8px;

  &:hover {
    background: #1A2A3A;
    color: #00BFFF;
  }

  &.active {
    background: #00BFFF;
    color: #FFFFFF;
  }

  &.web-feature {
    background: linear-gradient(135deg, #6B5CE7 0%, #8B6CE8 100%);
    
    &:hover {
      background: linear-gradient(135deg, #7B6CE8 0%, #9B7EF0 100%);
    }
    
    &.active {
      background: linear-gradient(135deg, #5B4CD6 0%, #7B5CD7 100%);
    }
  }
}

.menu-icon {
  font-size: 16px;
}
</style>
