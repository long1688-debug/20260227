<template>
  <div class="source-manager">
    <!-- 源预览列表 -->
    <div class="source-preview-bar">
      <div class="source-preview-list">
        <div
          v-for="source in paginatedSources"
          :key="source.id"
          class="source-preview-card"
          :class="{ dragging: isDraggingSource === source.id }"
          :data-source-id="source.id"
          @mousedown="handleMouseDown($event, source)"
          @touchstart="handleTouchStart($event, source)"
        >
          <!-- 卡片头部 -->
          <div class="preview-card-header">
            <span class="preview-card-title">
              <span class="source-type-icon">{{ getSourceTypeIcon(source.type) }}</span>
              {{ source.name }}
            </span>
            <el-tag :type="getSourceTypeTag(source.type)" size="small">
              {{ getSourceTypeLabel(source.type) }}
            </el-tag>
          </div>

          <!-- 预览视频 -->
          <div class="preview-card-video">
            <!-- 🎯 临时调试：显示 source 的 type 和 url -->
            <div style="position: absolute; top: 0; left: 0; background: rgba(0,0,0,0.8); color: lime; padding: 2px 4px; font-size: 10px; z-index: 999;">
              type: {{ source.type }}<br>
              url: {{ source.url ? '✅有' : '❌无' }}<br>
              blobUrl: {{ source.blobUrl ? '✅有' : '❌无' }}
            </div>

            <template v-if="source.type === 'localVideo' && source.url">
              <video
                :src="source.url"
                autoplay
                :muted="source.muted === true"
                :volume="(source.volume || 100) / 100"
                class="preview-video"
                @play="onVideoPlay(source)"
                @pause="onVideoPause(source)"
                @timeupdate="(e) => onVideoTimeUpdate(e, source)"
                @seeked="(e) => onVideoSeeked(e, source)"
                @loadedmetadata="(e) => onVideoLoaded(e, source)"
              />
              <!-- 进度条 -->
              <div class="preview-progress-bar" @click="seekVideo($event, source)">
                <div class="preview-progress-filled" :style="{ width: getProgress(source) + '%' }"></div>
              </div>
              <div class="preview-time-display">
                <span>{{ formatTime(source) }}</span>
              </div>
            </template>
            <video
              v-else-if="source.stream && source.type === 'localCamera'"
              :srcObject="source.stream"
              autoplay
              :muted="source.muted === true"
              class="preview-video"
              @play="onVideoPlay(source)"
            />
            <video
              v-else-if="source.streamUrl && ['networkCamera', 'remoteDesktop'].includes(source.type)"
              :src="source.streamUrl"
              autoplay
              muted
              class="preview-video"
            />
            <div v-else class="preview-placeholder">
              <span class="placeholder-icon">{{ getSourceTypeIcon(source.type) }}</span>
              <span class="placeholder-text">点击预览</span>
            </div>

            <!-- 状态覆盖层 -->
            <div class="preview-overlay">
              <div class="overlay-status" :class="{ online: source.status === 'online' }">
                <span class="status-dot"></span>
                <span class="status-text">{{ source.status === 'online' ? '在线' : '离线' }}</span>
              </div>
            </div>
          </div>

          <!-- 操作按钮 -->
          <div class="preview-card-actions">
            <!-- 音频选择器（本地视频和摄像头显示） -->
            <div v-if="['localVideo', 'localCamera'].includes(source.type)" class="audio-selector">
              <el-select
                v-model="sourceAudioMap[source.id]"
                size="small"
                placeholder="音频控制"
                @change="onAudioChange(source.id)"
                style="width: 100%;"
              >
                <el-option label="🔊 启用音频" value="preview" />
                <el-option label="🔇 静音" value="mute" />
              </el-select>
            </div>

            <!-- 音量控制（仅本地视频显示） -->
            <div v-if="source.type === 'localVideo'" class="volume-control">
              <el-slider
                v-model="source.volume"
                :min="0"
                :max="100"
                :step="1"
                @change="onVolumeChange(source)"
                size="small"
                show-tooltip
              />
            </div>

            <el-button size="small" @click.stop="$emit('rename', source)">重命名</el-button>
            <el-button size="small" type="danger" @click.stop="$emit('delete', source.id)">删除</el-button>
          </div>
        </div>

        <!-- 空状态 -->
        <div v-if="allSources.length === 0" class="source-preview-empty">
          <el-empty description="暂无信号源,请在顶部标签栏点击'信号源'添加" :image-size="60" />
        </div>
      </div>

      <!-- 分页控件 -->
      <div v-if="totalPages > 1" class="source-preview-pagination">
        <el-pagination
          v-model:current-page="currentPage"
          :page-size="pageSize"
          :total="allSources.length"
          layout="prev, pager, next"
          :hide-on-single-page="true"
          small
        />
      </div>
    </div>
  </div>
</template>

<script setup>
import { ref, computed, watch, nextTick } from 'vue';
import { useVideoSyncAdapter } from '@/composables/useVideoSyncAdapter';

const props = defineProps({
  allSources: {
    type: Array,
    default: () => []
  }
});

const emit = defineEmits(['drag-start', 'drag', 'drag-end', 'rename', 'delete', 'preview-video-play']);

const {
  initSourcePreviewProgress,
  onPreviewVideoTimeUpdate,
  onPreviewVideoLoadedMetadata,
  seekPreviewVideo,
  getPreviewProgress,
  formatPreviewTime,
  registerMasterVideo,
  unregisterSlaveVideo,
  clearMasterVideo
} = useVideoSync();

// 跟踪已注册的主控视频
const registeredMasters = new Set();

// 分页状态
const currentPage = ref(1);
const pageSize = ref(6);
const isDraggingSource = ref(null);

// ==================== 计算属性 ====================

const paginatedSources = computed(() => {
  const start = (currentPage.value - 1) * pageSize.value;
  const end = start + pageSize.value;
  return props.allSources.slice(start, end);
});

const totalPages = computed(() => {
  return Math.ceil(props.allSources.length / pageSize.value);
});

// ==================== 工具方法 ====================

const getSourceTypeIcon = (type) => {
  const icons = {
    localCamera: '📹',
    captureCard: '🎥',
    documentScanner: '📷',
    networkCamera: '🌐',
    mrCamera: '🥽',
    remoteDesktop: '🖥️',
    remoteCamera: '📡',
    mobileCamera: '📱',
    mobileScreen: '📲',
    localVideo: '🎬',
    networkStream: '📺',
    webpage: '🌍',
    ppt: '📊',
    word: '📝',
    mindmap: '🧠'
  };
  return icons[type] || '❓';
};

const getSourceTypeTag = (type) => {
  const tags = {
    localCamera: 'success',
    captureCard: 'success',
    documentScanner: 'success',
    networkCamera: 'warning',
    mrCamera: 'primary',
    remoteDesktop: 'info',
    remoteCamera: 'info',
    mobileCamera: 'warning',
    mobileScreen: 'warning',
    localVideo: 'primary',
    networkStream: 'danger',
    webpage: 'success',
    ppt: 'warning',
    word: 'info',
    mindmap: 'primary'
  };
  return tags[type] || '';
};

const getSourceTypeLabel = (type) => {
  const labels = {
    localCamera: '本地摄像头',
    captureCard: '采集卡',
    documentScanner: '高拍仪',
    networkCamera: '网络摄像机',
    mrCamera: 'MR摄像机',
    remoteDesktop: '远程桌面',
    remoteCamera: '远程摄像头',
    mobileCamera: '手机/平板摄像头',
    mobileScreen: '手机/平板桌面',
    localVideo: '媒体文件',
    networkStream: '网络串流',
    webpage: '网页',
    ppt: 'PPT',
    word: 'Word',
    mindmap: '思维导图'
  };
  return labels[type] || type;
};

// ==================== 视频预览 ====================

const onVideoTimeUpdate = (event, source) => {
  // 更新预览进度
  onPreviewVideoTimeUpdate(event, source);
};

const onVideoPlay = (source) => {
  // 更新播放状态
  if (source.previewProgress) {
    source.previewProgress.isPlaying = true;
  }
  console.log(`[SourceManager] 预览视频播放: ${source.id}`);
};

const onVideoPause = (source) => {
  // 更新暂停状态
  if (source.previewProgress) {
    source.previewProgress.isPlaying = false;
  }
  console.log(`[SourceManager] 预览视频暂停: ${source.id}`);
};

const onVideoSeeked = (event, source) => {
  console.log(`[SourceManager] 预览视频跳转: ${source.id}`);
  // 新架构：SyncStateReplicator 自动处理 seek 同步
};

const onVideoLoaded = (event, source) => {
  if (!source.previewProgress) {
    initSourcePreviewProgress(source);
  }
  onPreviewVideoLoadedMetadata(event, source);

  // 🎯 新架构：注册预览区域的视频为主控视频（Master）
  // 只有 Master 才能发起同步事件，画布（Slave）被动接收
  if (!registeredMasters.has(source.id)) {
    const videoElement = event.target;
    registerMasterVideo(videoElement, source.id);
    registeredMasters.add(source.id);
    console.log(`[SourceManager] ✅ 预览视频注册为 Master: ${source.id}`);
  }
};

const seekVideo = (event, source) => {
  // 预览视频快进
  seekPreviewVideo(event, source);
};

const getProgress = (source) => {
  return getPreviewProgress(source);
};

const formatTime = (source) => {
  return formatPreviewTime(source);
};

// ==================== 拖拽处理 ====================

// 🎯 鼠标按下开始拖拽（替代 HTML5 draggable）
const handleMouseDown = (event, source) => {
  // 只处理左键
  if (event.button !== 0) return;

  isDraggingSource.value = source.id;
  emit('drag-start', event, source);
};

// 🎯 触摸开始拖拽（触控设备支持）
const handleTouchStart = (event, source) => {
  // 阻止默认行为（防止页面滚动）
  event.preventDefault();

  isDraggingSource.value = source.id;
  emit('drag-start', event, source);
};

// 保留旧方法作为兼容（如果其他地方还在调用）
const onSourceDragStart = (event, source) => {
  handleMouseDown(event, source);
};

const onSourceDrag = (event, source) => {
  emit('drag', event, source);
};

const onSourceDragEnd = () => {
  isDraggingSource.value = null;
  emit('drag-end');
};

// ==================== 音频控制 ====================

const sourceAudioMap = ref({});

// 监听 allSources 变化，为新视频/摄像头初始化音频选择器
watch(() => props.allSources.length, () => {
  props.allSources.forEach(source => {
    // 为本地视频和摄像头都初始化音频选择器
    const needsAudioControl = source.type === 'localVideo' || source.type === 'localCamera';

    if (needsAudioControl && !sourceAudioMap.value[source.id]) {
      // 🎯 新添加的视频/摄像头默认选中静音
      sourceAudioMap.value[source.id] = 'mute';

      // 🎯 强制确保 muted 和 audioEnabled 属性存在且为正确值
      // 本地视频/摄像头添加到预览区域后默认静音
      if (source.muted === undefined || source.muted !== true) {
        source.muted = true;
      }
      if (source.audioEnabled === undefined || source.audioEnabled !== false) {
        source.audioEnabled = false;
      }
      // 🎯 确保音量设置为默认值
      if (source.volume === undefined) {
        source.volume = 100;
      }

      console.log(`[音频控制] 初始化音频选择器: ${source.name} (${source.type})`, {
        muted: source.muted,
        audioEnabled: source.audioEnabled,
        selectorValue: sourceAudioMap.value[source.id],
        volume: source.volume
      });

      // 🎯 强制更新 DOM 中的视频元素，确保预览区域默认静音
      nextTick(() => {
        const videoEl = document.querySelector(
          `.source-preview-card[data-source-id="${source.id}"] .preview-video`
        );
        if (videoEl) {
          videoEl.muted = true;
          videoEl.volume = source.volume / 100;
          console.log(`[音频控制] 强制设置 DOM 元素静音: ${source.name}, muted=${videoEl.muted}`);
        }
      });
    }
  });
}, { immediate: true });

/**
 * 视频播放事件 - 默认静音，不自动互斥
 * 用户需要通过音频控制区域来选择播放哪个视频/摄像头的声音
 */
const onVideoPlay = (source) => {
  console.log(`[音频控制] 视频开始播放: ${source.name} (${source.type}, muted=${source.muted})`);

  // 如果该视频/摄像头的音频未启用，保持静音
  if (!source.audioEnabled) {
    console.log(`[音频控制] ${source.name} (${source.type}) 音频未启用，保持静音`);
    return;
  }

  // 🎯 支持多选：只确保当前视频不静音，不影响其他视频
  source.muted = false;
  const videoEl = document.querySelector(
    `.source-preview-card[data-source-id="${source.id}"] .preview-video`
  );
  if (videoEl) {
    videoEl.muted = false;
  }

  // 统计当前启用音频的源数
  const enabledCount = props.allSources.filter(s =>
    (s.type === 'localVideo' || s.type === 'localCamera') && s.audioEnabled === true
  ).length;
  console.log(`[音频控制] ✅ 当前发声源: ${source.name} (${source.type}) (共 ${enabledCount} 个源发声)`);
};

const onAudioChange = (sourceId) => {
  const audioChoice = sourceAudioMap.value[sourceId];
  const source = props.allSources.find(s => s.id === sourceId);

  if (!source) return;

  console.log(`[音频控制] 音频选择变更: ${source.name} (${source.type}) -> ${audioChoice}`);

  if (audioChoice === 'preview') {
    // 🎯 启用该视频/摄像头的音频（支持多选，不影响其他）
    source.audioEnabled = true;
    source.muted = false;

    // 更新当前视频/摄像头的 DOM 元素
    const videoEl = document.querySelector(
      `.source-preview-card[data-source-id="${sourceId}"] .preview-video`
    );
    if (videoEl) {
      videoEl.muted = false;
    }

    console.log(`[音频控制] 🔊 启用音频: ${source.name} (${source.type})`);
  } else {
    // 🎯 静音该视频/摄像头
    source.audioEnabled = false;
    source.muted = true;

    // 更新 DOM 中的视频元素
    const videoEl = document.querySelector(
      `.source-preview-card[data-source-id="${sourceId}"] .preview-video`
    );
    if (videoEl) {
      videoEl.muted = true;
    }

    console.log(`[音频控制] 🔇 静音: ${source.name} (${source.type})`);
  }

  // 🎯 检查是否有任何视频/摄像头启用了音频
  const anyAudioEnabled = props.allSources.some(s =>
    (s.type === 'localVideo' || s.type === 'localCamera') && s.audioEnabled === true
  );

  if (!anyAudioEnabled) {
    console.log(`[音频控制] ⚠️ 没有选择任何音频，全部静音`);
  } else {
    const enabledCount = props.allSources.filter(s =>
      (s.type === 'localVideo' || s.type === 'localCamera') && s.audioEnabled === true
    ).length;
    console.log(`[音频控制] 📊 当前启用音频的源数: ${enabledCount}`);
  }
};

const onVolumeChange = (source) => {
  console.log(`[SourceManager] 音量变更: ${source.name} -> ${source.volume}`);

  // 更新源对象的音量
  source.volume = source.volume || 100;

  // 更新 DOM 中的视频元素音量
  const videoEl = document.querySelector(`.source-preview-card[data-source-id="${source.id}"] .preview-video`);
  if (videoEl) {
    videoEl.volume = source.volume / 100;
    videoEl.muted = false;
    source.muted = false;
    console.log(`[SourceManager] 已更新视频音量: ${source.volume}%`);
  }
};
</script>

<style scoped lang="scss">
.source-manager {
  width: 100%;
}

.source-preview-bar {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.source-preview-list {
  display: flex;
  gap: 8px;
  overflow-x: auto;
  padding: 8px 0;

  &::-webkit-scrollbar {
    height: 6px;
  }

  &::-webkit-scrollbar-thumb {
    background: var(--border-color, #415A77);
    border-radius: 3px;
  }
}

.source-preview-card {
  flex-shrink: 0;
  width: 200px;
  background: var(--bg-secondary, #1B263B);
  border-radius: 8px;
  border: 1px solid var(--border-color, #415A77);
  transition: all 0.2s ease;

  // 🎯 触摸优化：禁用默认触摸行为，防止页面滚动
  touch-action: none;
  -webkit-user-select: none;
  user-select: none;
  -webkit-tap-highlight-color: transparent;

  &.dragging {
    opacity: 0.5;
    transform: scale(0.95);
  }

  &:hover {
    border-color: var(--color-primary, #4CC9F0);
    box-shadow: 0 2px 8px rgba(76, 201, 240, 0.2);
  }

  // 🎯 触摸激活状态
  &:active {
    transform: scale(0.98);
  }
}

.preview-card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8px 12px;
  background: var(--bg-tertiary, #415A77);

  .preview-card-title {
    font-size: 14px;
    font-weight: 500;
    color: var(--text-primary, #E0E1DD);
    display: flex;
    align-items: center;
    gap: 6px;
  }
}

.preview-card-video {
  position: relative;
  height: 120px;
  background: var(--bg-primary, #0D1B2A);
  overflow: hidden;  // 🎯 修复：确保子元素不会溢出

  .preview-video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: relative;
    z-index: 1;  // 🎯 修复：设置视频在底层
  }

  .preview-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    color: var(--text-secondary, #ADB5BD);

    .placeholder-icon {
      font-size: 32px;
      margin-bottom: 8px;
    }
  }
}

.preview-progress-bar {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 12px;  // 🎯 临时调试：固定高度12px，确保可见
  background: rgba(255, 0, 0, 0.7);  // 🎯 临时调试：红色背景，更容易看到
  cursor: pointer;
  z-index: 100;  // 🎯 临时调试：提高z-index确保在最上层
  border: 2px solid yellow;  // 🎯 临时调试：黄色边框

  &:hover {
    height: 16px;
  }

  .preview-progress-filled {
    height: 100%;
    background: var(--color-primary, #4CC9F0);
    transition: width 0.1s linear;
  }
}

.preview-time-display {
  position: absolute;
  bottom: 12px;  // 🎯 修复：从8px调整到12px，避免遮挡进度条
  right: 8px;
  font-size: 11px;
  color: var(--text-primary, #E0E1DD);
  background: rgba(0, 0, 0, 0.7);  // 🎯 修复：加深背景，提高可读性
  padding: 3px 8px;  // 🎯 修复：增加内边距
  border-radius: 4px;
  z-index: 2;  // 🎯 新增：确保在最上层
}

.preview-overlay {
  position: absolute;
  top: 8px;
  left: 8px;

  .overlay-status {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: 11px;
    color: var(--text-muted, #6C757D);
    background: rgba(0, 0, 0, 0.6);
    padding: 2px 6px;
    border-radius: 4px;

    &.online {
      color: var(--color-success, #06D6A0);
    }

    .status-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: currentColor;
    }
  }
}

.preview-card-actions {
  display: flex;
  flex-direction: column;
  gap: 4px;
  padding: 8px;
  background: var(--bg-secondary, #1B263B);

  .audio-selector {
    margin-bottom: 4px;
  }

  .volume-control {
    padding: 0 4px;
  }
}

.source-preview-empty {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 120px;
}

.source-preview-pagination {
  display: flex;
  justify-content: center;
  padding: 8px 0;
}
</style>
